// 获取左侧导航
function sideLoad(obj, level) {
    let sideList = [];
    let list = JSON.parse(localStorage.getItem("menusTree")).subMenus
    list = platFn(list);
    if (obj.level == '1') {
        sideList = obj.subMenus;
        sideList.forEach((item, index) => {
            item.active = false;
        })
        sideList[0].active = true;
    } else if (obj.level == '2') {
        let pid = obj.pid;
        sideList = list.filter(t => t.id == pid);
        sideList = sideList[0].subMenus
        sideList.forEach((item, index) => {
            if (item.id == obj.id) {
                item.active = true;
            } else {
                item.active = false;
            }
        })
    } else if (obj.level == '3') {
        // let pid = obj.id.split('.');
        // 二级id
        // let secondidList = obj.pid;
        let secondid = obj.pid
        // 一级id
        let firstid = list.filter(t => t.id == secondid)[0].pid;
        // firstid = firstid.join(".");
        sideList = list.filter(t => t.id == firstid)[0].subMenus;
        sideList.forEach((item, index) => {
            if (item.id == secondid) {
                item.active = true;
            } else {
                item.active = false;
            }
        })
    }
    sideList = JSON.stringify(sideList);
    localStorage.setItem("sideNav", sideList)
}
//获取三级导航  id3='三级id’
