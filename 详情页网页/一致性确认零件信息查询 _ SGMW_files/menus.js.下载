                    }
                })
                if(menusNavDelType){
                    storgeTab.map(t=> {
                        t.checkType = false
                        if(obj.id == t.id){
                            t.checkType=true;
                        }
                    })
                    navTabList.map(t=> t.checkType = false)
                    // storgeTab[0].checkType=true;
                }
                navTabList = [...storgeTab,...navTabList];
            }
            let newobj = {};
            navTabList = navTabList.reduce((preVal, curVal) => {
            		newobj[curVal.id] ? '' : newobj[curVal.id] = preVal.push(curVal);
            		return preVal
            	}, [])
            navTabList = JSON.stringify(navTabList);
            localStorage.setItem("navTab", navTabList)
        }
    } else if (obj.level == '3') {
        let storgeTab = localStorage.getItem("navTab");
        if(storgeTab) {
            storgeTab=JSON.parse(storgeTab)
            let type=false;
            storgeTab.map(t => {
                t.checkType = false
