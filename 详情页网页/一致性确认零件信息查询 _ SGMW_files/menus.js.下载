            navTabList[0].checkType = true;

            if(storgeTab){
                storgeTab=JSON.parse(storgeTab)
                storgeTab.map(t=>{
                    t.checkType = false
                    if(navTabList[0].id == t.id){
                        navTabList[0].checkType=false;
