dispatchEventStroage();
function dispatchEventStroage() {
    const storage = localStorage.setItem
    localStorage.setItem = function(key, val) {
        let setEvent = new Event('setItemEvent')
        setEvent.key = key
        setEvent.newValue = val
        window.dispatchEvent(setEvent)
        storage.apply(this, arguments)
    }
}

// 一级菜单
function firstLevelMenu(obj) {
    // let list = platFn(obj);
    // list
    if (obj.subMenus && obj.subMenus.length > 0) {
        for (let i = 0; i < obj.subMenus.length; i++) {
            if (obj.subMenus[i].display == '1') {
                secondaryMenu(obj.subMenus[i])
                break;
            }
        }
    } else {
        openUrl(obj);
    }
}
// 二级菜单
function secondaryMenu(obj) {
    if (obj.subMenus && obj.subMenus.length > 0) {
        let menus = obj.subMenus.filter(t => t.display == '1');
        if (menus.length == 0) {
            threeLevelMenu(obj);
            return;
        }
        for (let i = 0; i < menus.length; i++) {
            // if(obj.subMenus[i].display=='1'){
            openUrl(menus[i]);
            // }
            return;
        }
    } else {
        openUrl(obj);
    }
}
