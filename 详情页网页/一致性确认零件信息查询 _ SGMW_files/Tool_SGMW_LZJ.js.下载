// 副表格部分和公用的方法
var vicePublicTableAndMethod = Vue.component('vice-public-table-and-method-lzj', {
    props: ['vicTempletList', 'viceTableHeadObj', 'viceFormSelectUrlObjArr', 'isCheckBox', 'isNumber', 'align', 'getViceDataUrl', 'viceTableUrlObj', 'viceLinkageSelectInterfaceArr', 'pageUrls', 'idNames', 'viceTempletList'],
    data: function () {
        return {
            searchViceObj: {}, //用户存放查询副表格数据的对象的变量
            table: {},
            submitFormType: "", //执行表单中提交方法的类型, 判断是新增方法,还是编辑方法, 1-新增 2-编辑
            checkedTableDataId: '', //此变量用于编辑功能时，存储被勾选的数据的ID
            tableData: [],
            columnObj: {},
            columnObjArr: [],
            tableColumn: [],
            layerBox: '', //定义一个弹出框的标识变量名称，这个的作用是用于在接口调用并且方法执行成功之后（例如新增或编辑方法），单独关闭所对应的提示框
            total: '', //记录表格的总数据条数
            pageSize: '', //当前每页展示的数据的条数
            size: ['700px', '450px'],
        }
    },
    template:
        '<div>' +
        '<table id="vice_table" lay-filter="vice_test"></table>' +
        '<div id="viceTablePager"></div>' +
        '</div>',

    created: function () {
        var _this = this;

        transfer.$off('transferParam');
        transfer.$on("transferParam", function (msg) {
            _this.searchViceObj = {};
            _this.searchViceObj = msg;
            if (_this.searchViceObj.removeTableData) {
                _this.tableData = [];
                _this.drawTableFunc();
            } else {
                _this.$emit("disabledvicebtn", _this.searchViceObj)
                _this.getViceTableDataFunc(function () {
                    _this.loadViceTablePager();
                });
            }
        });
    },
    beforeDestroy() {
        transfer.$off('transferParam');
    },
    mounted: function () {
        var _this = this;
        //在前端定义好副表格的表单中是否有下拉菜单，如果有这个变量，则执行下方方法，循环对象数组，获取每个下拉菜单对应的数据
        if (_this.viceFormSelectUrlObjArr != undefined) {
            _this.getViceFormSelectDataFunc();
        }
        //在前端定义判断副表格中的下拉菜单选项是否属于联动回显的类型，，如果有这个变量，则执行下方方法，处理下拉菜单数据联动的问题
        if (_this.viceLinkageSelectInterfaceArr != undefined) {
            _this.getLinkageSelectDataFunc()
        }
    },
    methods: {
        /*
       * author: wangweili
       * description: 子表格行内按钮点击事件
       * time: 2020/09/17
       */
        vicTableButtonClick: function () {
            var _this = this;
            //表格行内的操作，包括获取表格单行的数据，表格单行操作列按钮
            _this.table.on('tool(vice_test)', function (obj) {
                if (obj.event !== 'setSign') {
                    _this.$emit('victablebuttonclick', obj);
                }
            });
        },

        /*
        * author: linzijan
        * description:附表格加载时间选择器的方法
        * time: 2020/09/21
        */
        LastTableLoadDataTimePickerFunc: function (type, domId) {
            if (!domId) {
                layuiEvent.laydate.render({
                    elem: '#chooseTime',//通过id绑定html中插入的end
                    type: 'date',
                    min: "1970-1-1",//设置min默认最小值
                    isInitValue: true,
                    value: '1989-10-14',
                });
                return
            }
            domId.forEach(function (item, index) {
                layuiEvent.laydate.render({
                    elem: item,//通过id绑定html中插入的end
                    type: type[index],
                    min: "1970-1-1",//设置min默认最小值
                    isInitValue: true,
                    // value: '1989-10-14',
                });
            })
        },
        /**
         * author: zhangqi
         * description: 调用接口，查询并获取表格数据
         * time: 2020/09/21
         */
        getViceTableDataFunc: function (callback) {
            var _this = this;
            _this.tableData = {};
            var searchData = {}
            if (_this.pageUrls) {
                if (_this.idNames[_this.searchViceObj.childType].type) {
                    layuiEvent.admin.req(_this.pageUrls[_this.searchViceObj.childType] + _this.searchViceObj.parentId, {}, function (res) {
                        if (res.ok) {
                            _this.tableData = [res.data];
                            _this.total = res.data.total ? res.data.total : 1;
                            _this.pageSize = res.data.size ? res.data.size : 1;
                            //执行拼接绘制渲染表格的方法
                            _this.drawTableFunc();
                            callback && callback();
                        } else {
                            layerInfo(res.message, 2);
                        }
                        _this.searchViceObj[_this.idNames[_this.searchViceObj.childType]] = '';
                    }, { method: 'GET' })
                } else {
                    $.each(_this.idNames[_this.searchViceObj.childType], function (key, val) {
                        if (!_this.searchViceObj.parentData[val]) {
                            searchData[key] = _this.idNames[_this.searchViceObj.childType][key];
                        } else {
                            searchData[key] = _this.searchViceObj.parentData[val];
                        }
                    });
                    searchData.childType = _this.searchViceObj.childType;
                    searchData.current = _this.searchViceObj.current;
                    searchData.size = _this.searchViceObj.size;
                    layuiEvent.admin.req(_this.pageUrls[_this.searchViceObj.childType], searchData, function (res) {
                        if (res.ok) {
                            _this.tableData = res.data.records;
                            _this.total = res.data.total;
                            _this.pageSize = res.data.size
                            //执行拼接绘制渲染表格的方法
                            _this.drawTableFunc();
                            callback && callback();
                        } else {
                            layerInfo(res.message, 2);
                        }
                        _this.searchViceObj[_this.idNames[_this.searchViceObj.childType]] = '';
                    }, { method: 'GET' })
                }
            } else {
                layuiEvent.admin.req(_this.getViceDataUrl, _this.searchViceObj, function (res) {
                    if (res.ok) {
                        _this.tableData = res.data.records;
                        _this.total = res.data.total;
                        _this.pageSize = res.data.size
                        //执行拼接绘制渲染表格的方法
                        _this.drawTableFunc();
                        callback && callback();
                    } else {
                        layerInfo(res.message, 2);
                    }
                }, { method: 'GET' }
                )
            }
        },
        /*
        * author: zhangqi
        * description: 拼接绘制渲染表格
        * time: 2020/09/16
        */
        drawTableFunc: function () {
            var _this = this;
            _this.tableColumn = [];
            _this.columnObjArr = [];
            //判断表格是否开启多选列，如果开启在表格中添加多选列
            if (_this.isCheckBox) {
                _this.tableColumn.push({ type: 'checkbox', fixed: 'left' })
            }
            //判断表格是否开启序号列，如果开启在表格中添加序号列
            if (_this.isNumber) {
                _this.tableColumn.push({ type: 'numbers', title: '序号', fixed: 'left' })
            }

            // 循环对象中的数组获取表头数据，整合绘制表格所需要的数据格式
            _this.viceTableHeadObj[tabsIndex][0].forEach(function (item) {
                _this.columnObj = { title: item, align: _this.align, event: 'setSign' }
                //月计划使用
                if (_this.vicTempletList != undefined) {
                    _this.columnObj.templet = _this.vicTempletList[item];
                }
                if (_this.viceTempletList != undefined) {
                    _this.columnObj.templet = _this.viceTempletList[item];
                }
                _this.columnObjArr.push(_this.columnObj);
                _this.columnObj = {}
            })

            // 循环数据字段的数组，赋值给中间变量数组中的字段，整合绘制表格所需要的数据格式
            _this.viceTableHeadObj[tabsIndex][1].forEach(function (item, index) {
                _this.columnObjArr[index].field = item;
            })

            // 循环是否固定列的数组，赋值给中间变量数组中的字段，整合绘制表格所需要的数据格式
            if (_this.fixedColumn != undefined) {
                _this.fixedColumn.forEach(function (item, index) {
                    _this.columnObjArr[index].fixed = item;
                });
            }

            // 循环中间变量数组，将数组中的每一条数据添加进新的数组中，然后新的数组是表格所需要的并且已经整理好格式的数据
            _this.columnObjArr.forEach(function (item) {
                _this.tableColumn.push(item)
            });
            //_this.tableColumn.concat(_this.columnObjArr)

            layui.use('table', function () {
                _this.table = layui.table
                //展示已知数据
                _this.table.render({
                    elem: '#vice_table',
                    // url: _this.getTableDataUrl,
                    data: _this.tableData,
                    cols: [_this.tableColumn],
                    cellMinWidth: 120,
                    limit: _this.pageSize,
                });
            });

            //渲染子表格行内按钮点击事件
            _this.vicTableButtonClick();
            // 零件信息模块，副表格中存在新增，编辑，删除等操作，未加载查询副表格数据之前不应该显示此按钮组，
            // 所以在此处副表格数据完成查询并渲染之后，显示操作的按钮组
            _this.$emit("showbuttongroup", true)
        },

        /**
         * author: zhangqi
         * description: 加载副表格分页
         * time: 2020/09/17
         */
        loadViceTablePager: function () {
            var _this = this;
            layuiEvent.laypage.render({
                elem: 'viceTablePager',
                count: _this.total,
                layout: ['count', 'limit', 'prev', 'page', 'next', 'skip'],
                prev: '<em><i class="layui-icon" ><</i></em>',
                next: '<em><i class="layui-icon" >></i></em>',
                jump: function (obj) {
                    _this.searchViceObj.size = obj.limit;
                    _this.searchViceObj.current = obj.curr;
                    _this.getViceTableDataFunc();
                }
            });
        },

        /*
        * author: zhangqi
        * description: 循环对象数组，获取每个下拉菜单对应的数据
        * time: 2020/10/09
        */
        getViceFormSelectDataFunc: function () {
            var _this = this;
            _this.viceFormSelectUrlObjArr.forEach(function (ss) {
                $.each(ss, function (key, val) {
                    layuiEvent.admin.req(val, {}, function (res) {
                        if (res.ok) {
                            res.data.forEach(function (item) {
                                $('#' + key).append("<option value='" + item + "'>" + item + "</option>");
                                layuiEvent.form.render("select");
                            })
                        } else {
                            layerInfo(res.message, 2);
                        }
                    }, { method: 'GET' }
                    );
                })
            })
        },

        /**
         * description:点击副表格上方‘新增’按钮执行的方法
         * author:zhangqi
         * time: 2020-09-29
         */
        addViceDataFunc: function (size, dateType, domId) {
            var _this = this;
            _this.LastTableLoadDataTimePickerFunc(dateType, domId);
            size = size ? size[_this.searchViceObj.childType] : _this.size;
            //给表单中提交方法的类型的变量赋值, 判断是新增方法,还是编辑方法, 1-新增 2-编辑
            _this.submitFormType = 1;
            //清空表单中所有内容，
            document.getElementById("layui-vice-form-" + _this.searchViceObj.childType).reset();
            _this.layerBox = layer.open({
                type: 1,
                title: '新增',
                closeBtn: 1,
                area: [size.width + 'px', size.height + 'px'],
                shade: false,
                shadeClose: false,
                content: $("#layui-vice-form-" + _this.searchViceObj.childType),
            });
        },

        /*
        * author: zhangqi
        * description: 主表格顶部编辑按钮执行的方法
        * time: 2020/09/21
        */
        editViceDataFunc: function (size) {
            var _this = this;
            _this.checkedTableDataId = '';
            size = size || _this.size;
            //给表单中提交方法的类型的变量赋值, 判断是新增方法,还是编辑方法, 1-新增 2-编辑
            _this.submitFormType = 2;
            //获取表格中被勾选的数据的集合
            var checkStatus = _this.table.checkStatus('vice_table')
            //data是一个数组，数组中的元素是表格中被勾选所有数据
            var data = checkStatus.data;
            if (data.length == 0) {
                layer.alert('请先勾选一条数据', {
                    title: '提示',
                    icon: 5,
                    btn: ['关闭']
                });
                return false
            } else if (data.length > 1) {
                layer.alert('只能选择一条数据进行编辑', {
                    title: '提示',
                    icon: 5,
                    btn: ['关闭']
                });
                return false
            } else {
                _this.layerBox = layer.open({
                    type: 1,
                    title: '编辑',
                    closeBtn: 1,
                    area: [size.width + 'px', size.height + 'px'],
                    shade: false,
                    shadeClose: false,
                    content: $("#layui-vice-form-" + _this.searchViceObj.childType),
                });

                //表单赋值
                layuiEvent.form.val('example-' + _this.searchViceObj.childType, data[0]);
                _this.checkedTableDataId = data[0].id;
            }
        },

        /**
         * description:提交表单数据
         * author:zhangqi
         * time: 2020-09-16
         * param: mainTableCurrentRowId 在操作子表格的新增或编辑方法时，要获取主表格当前选中行的数据的id
         */
        submitViceFormFunc: function (mainTableCurrentRowId) {
            var _this = this;
            var obj = {};
            layuiEvent.form.on('submit(vaic-form-' + _this.searchViceObj.childType + ')', function (data) {
                obj = JSON.parse(JSON.stringify(data.field))
                obj[mainTableCurrentRowId] = _this.searchViceObj.parentId;
                if (_this.submitFormType == 1) {
                    obj = JSON.parse(JSON.stringify(data.field))
                    obj[mainTableCurrentRowId] = _this.searchViceObj.parentId;
                    //调用新增接口，新增数据
                    layuiEvent.admin.req(_this.viceTableUrlObj[_this.searchViceObj.childType].addOrEditUrl, obj, function (res) {
                        if (res.ok) {
                            layerInfo("数据新增成功", 1);
                            layer.close(_this.layerBox);
                            _this.getViceTableDataFunc(function () {
                                _this.loadViceTablePager()
                            });
                        } else {
                            layerInfo(res.message, 2);
                        }
                    }, { method: 'POST' }
                    )
                } else if (_this.submitFormType == 2) {
                    obj.id = _this.checkedTableDataId;
                    layuiEvent.admin.req(_this.viceTableUrlObj[_this.searchViceObj.childType].addOrEditUrl, obj, function (res) {
                        if (res.ok) {
                            layerInfo("数据编辑成功", 1);
                            layer.close(_this.layerBox);
                            _this.getViceTableDataFunc();
                        } else {
                            layerInfo(res.message, 2);
                        }
                    }, { method: 'POST' }
                    )
                }
                return false
            });
        },

        /**
         * author: zhangqi
         * description: 主表格顶部删除按钮执行的方法
         * time: 2020/09/17
         */
        deleteViceDataFunc: function () {
            var _this = this;
            //获取表格中被勾选的数据的集合
            var checkStatus = _this.table.checkStatus('vice_table')
            var data = checkStatus.data;
            //当点击删除按钮时，判断当前是否有选中数据
            if (data.length == 0) {
                layer.alert('请先勾选一条数据', {
                    title: '提示',
                    icon: 5,
                    btn: ['关闭']
                });
            } else {
                layer.alert('确认要删除已勾选的数据吗？', {
                    title: '删除',
                    icon: 3,
                    btn: ['确定', '关闭'],
//                  area: ['400px', '200px'], //宽高
                }, function () {
                    //获取每条数据的id，并添加进新的数组中
                    var ids = []
                    data.forEach(function (item) {
                        ids.push(item.id)
                    });
                    //调用删除接口，删除数据
                    layuiEvent.admin.req(_this.viceTableUrlObj[_this.searchViceObj.childType].deleteUrl, { "ids": ids }, function (res) {
                        if (res.ok) {
                            layerInfo("数据删除成功", 1);
                            _this.getViceTableDataFunc(function () {
                                _this.loadViceTablePager()
                            });
                        } else {
                            layerInfo(res.message, 2);
                        }
                    }, { method: 'DELETE' }
                    );
                });
            }
        },

        /*
        * author: linzijian
        * description: 获取新增或编辑的表单中，下拉菜单类型的查询条件中的所有数据，这个方法在此js中封装，
        *              可以简化前端页面的代码重复性，当选择好下拉菜单中的数据后，这样操作还可以直接获取选择的数据，传入接口中（联动下拉）
        * time: 2020/10/13
        */
        getLinkageSelectDataFunc: function () {
            var _this = this;
            _this.viceLinkageSelectInterfaceArr.forEach(function (ss) {
                _this.getLinkageData(ss);
            })
        },
        getLinkageData: function (ss, data) {
            var _this = this;
            var searchData = {};
            $.each(ss, function (key, val) {
                if (data) {
                    searchData[val.fieldIdentifier] = data;
                } else if (val.requestData) {
                    searchData = val.requestData;
                }
                layuiEvent.admin.req(val.url, searchData, function (res) {
                    if (res.ok) {
                        $('#' + key).html('<option value=""> 请选择 </option>');
                        if (val.clearDomID) {
                            val.clearDomID.forEach(function (item) {
                                $('#' + item).html('<option value=""> 请选择 </option>');
                            })
                        }
                        res.data.forEach(function (item) {
                            $('#' + key).append("<option value='" + item[val.value] + "'>" + item[val.name] + "</option>");
                            layuiEvent.form.on('select(' + key + ')', function (data) {//对应lay-filter
                                if (val.echoSelectId) {
                                    $('#' + val.echoSelectId).val(data.value);
                                }
                                if (val.children) {
                                    val.children.forEach(function (ss) {
                                        _this.getLinkageData(ss, data.value);
                                    })
                                }
                                layuiEvent.form.render("select");
                            })
                            layuiEvent.form.render("select");
                        })
                    } else {
                        layerInfo(res.message, 2);
                    }
                }, { method: val.requestType }
                );
            })
        },

        /**
         * author: zhangqi
         * description: 加载 select下拉菜单中带有分页表格的方法
         * time: 2021/01/20
         */
        viceTableSelectLoadFunc: function (obj) {
            var _this = this;
            //定义展示表格数据的数据结构模板
            var colsArr = [];
            //根据选择类型的参数判断选择方式为单选或者多选，如果没有这个参数则默认选择方式是单选
            var checkType = obj.checkType || 'radio'
            //添加勾选操作列
            colsArr.push({ type: checkType });
            //循环数据，继续添加表格数据列
            $.each(obj.tableCols, function (key, value) {
                colsArr.push({ title: key, field: value, align: 'center' })
            })
            var tableSelect = layui.tableSelect;
            tableSelect.render({
                elem: '#' + obj.elem, //定义输入框input对象 必填
                checkedKey: obj.checkedKey, //表格的唯一建值，非常重要，影响到选中状态 必填
                searchKey: obj.searchKey,	//搜索输入框的name值 默认keyword
                searchPlaceholder: '关键词搜索',	//搜索输入框的提示文字 默认关键词搜索
                table: {	//定义表格参数，与LAYUI的TABLE模块一致，只是无需再定义表格elem
                    url: obj.url,
                    cols: [colsArr],
                    page: true,
                    request: {
                        pageName: 'current', //页码的参数名称，默认：page
                        limitName: 'size' //每页数据量的参数名，默认：limit
                    },
                    limit: 20,
                    parseData: function (res) { //res 即为原始返回的数据
                        return {
                            "code": res.respCode, //解析接口状态
                            "msg": res.message, //解析提示文本
                            "count": res.data.total, //解析数据长度
                            "data": res.data.records //解析数据列表
                        };
                    },
                },
                done: function (elem, data) {
                    //选择完后的回调，包含2个返回值 elem:返回之前input对象；data:表格返回的选中的数据 []
                    //拿到data[]后 就按照业务需求做想做的事情啦~比如加个隐藏域放ID...
                    var storageDataObj = {};
                    if (checkType == 'radio') {
                        obj.fillFieldDataArr.forEach(function (item) {
                            layuiEvent.form.val('example-' + _this.searchViceObj.childType, { [item]: data.data[0][item] });
                            storageDataObj[item] = data.data[0][item]
                        })
                    } else if (checkType == 'checkbox') {
                        var arr = [];
                        obj.fillFieldDataArr.forEach(function (item) {
                            data.data.forEach(function (ss) {
                                arr.push(ss[item]);
                            })
                            layuiEvent.form.val('example-' + _this.searchViceObj.childType, { [item]: arr.join() });
                            storageDataObj[item] = arr.join()
                            arr = [];
                        })
                    }
                    //需要进行联动晒段选择数据的时候才会执行的方法
                    if (obj.isEnableLinkage) {
                        _this.viceLinkageParamObj = {};
                        obj.enableLinkageParamArr.forEach(function (item) {
                            _this.viceLinkageParamObj[item] = storageDataObj[item];
                        })
                        obj.emptyDomValue.forEach(function (item) {
                            layuiEvent.form.val('example', { [item]: '' });
                        })
                    }
                }
            })
        },

