        '</div>' +
        '<span class="g-layui-upload-flie-type-tips">请上传50M以内Excel格式的文件。</span>' +
        '<div class="g-layui-upload-btn-group">' +
        '<button type="submit" class="layui-btn layui-btn-normal g-layui-upload-btn" @click="uploadsubmitbtn" id="upload">确定</button>' +
        '<button type="button" class="project_btnStyle restBtn layui-btn layui-btn-primary" @click="closeUploadModalFunc">取消</button>' +
        '</div>' +
        '</div>' +
        '</div>',

    mounted: function () {
        var _this = this;
        //重置用于查询副表格数据的全局变量
        searchViceObjParam = {
            "parentId": '', //主表格中被选中的一行数据的id
            "childType": 0, //tabs标签项中的位置
