// 公用的表格和公用的方法
var mainPublicTableAndMethodLXF = Vue.component('main-public-table-and-method-lxf', {
    /*
     * description: props参数说明
     * searchParam: 选择的查询条件的对象
     * selectInterfaceArr: 页面顶部查询条件中下拉菜单类型的查询条件的所对应的接口
     * mainFormSelectInterfaceArr: 新增或编辑的表单中下拉菜单类型的查询条件的所对应的接口
     * headData: 表头内容
     * fieldData: 对应字段
     * fixedColumn: 是否固定列
     * isCheckBox: 是否开启多选列
     * isNumber: 是否开启序号列
     * align: 表格内容的对齐方式  left左对齐，center居中对齐，right右对齐
     * operationText: 带有其他操作按钮的列的列名称
     * operationBtnList: 带有其他操作按钮的列中的内容
     * getMainTableAllDataUrl: 获取主表格所有数据的接口地址
     * addMainTableDataUrl: 新增一条主表格数据的接口地址
     * deleteMainTableDataUrl: 删除一条或多条主表格数据的接口地址
     * downloadTemplateUrl: 下载模板的接口
     * uploadFileUrl: 导入（上传）文件的接口地址
     * exportDataUrl: 导出文件的接口
     */
    props: ['searchParam', 'mainLinkageData', 'mainLinkageSelectInterfaceArr', 'selectInterfaceArr', 'mainFormSelectInterfaceArr', 'headData', 'fieldData', 'fixedColumn',
        'isCheckBox', 'isNumber', 'align', 'operationText', 'operationFixed', 'operationBtnList', 'columnWidth', 'templetList',
        'getTableDataUrl', 'addOrEditTableDataUrl', 'publishTableDataUrl', 'deleteTableDataUrl', 'unlockTableDataUrl', 'retractTableDataUrl', 'approvalTableDataUrl',
        'downloadTemplateUrl', 'uploadFileUrl', 'exportDataUrl', 'isShow'],
    data: function () {
        return {
            table: {},
            submitFormType: "", //执行表单中提交方法的类型, 判断是新增方法,还是编辑方法, 1-新增 2-编辑
            checkedTableDataId: '', //此变量用于编辑功能时，存储被勾选的数据的ID
            tableData: [],
            columnObj: {},
            columnObjArr: [],
            tableColumn: [],
            size: ['700px', '450px'],
            layerBox: '', //定义一个弹出框的标识变量名称，这个的作用是用于在接口调用并且方法执行成功之后（例如新增或编辑方法），单独关闭所对应的提示框
            total: '', //记录表格的总数据条数
            pageSize: '', //当前每页展示的数据的条数
            uploadFileName: '', //选择上传的文件的文件名称
            uploadDom: null,
            files: null,
        }
    },
    template:
        '<div>' +
        '<table id="main_table" lay-filter="main_test"></table>' +
        '<div id="tablePager"></div>' +
        '<div id="layui-upload" style="display: none">' +
        '<div class="layui-upload g-layui-upload" id="aaa">' +
        '<label class="g-upload-lable"><span style="color: red;">*</span>文件:</label>' +
        '<input class="g-layui-upload-input" type="text" v-model="uploadFileName" lay-verify="required" autocomplete="off" placeholder="请上传文件" disabled>' +
        '<button type="button" class="layui-btn layui-btn-normal g-layui-upload-btn" id="chooseFile">选择文件</button>' +
        '</div>' +
        '<span class="g-layui-upload-flie-type-tips">请上传50M以内Excel格式的文件。</span>' +
        '<div class="g-layui-upload-btn-group">' +
        '<button type="submit" class="layui-btn layui-btn-normal g-layui-upload-btn"  @click="uploadsubmitbtn" id="test9">确定</button>' +
        '<button type="button" class="layui-btn layui-btn-primary g-layui-upload-btn" @click="closeUploadModalFunc">取消</button>' +
        '</div>' +
        '</div>' +
        '</div>',
    mounted: function () {
        var _this = this;
        //给查询条件的对象‘searchParam’，拼接上分页器所属的对象(size:每页展示多少条，current:当前选择的第几页)
        Object.assign(_this.searchParam, {size: '', current: ''})
        //重置用于查询副表格数据的全局变量
        searchViceObjParam = {
            "id": '', //主表格中被选中的一行数据的id
            "childType": 0, //tabs标签项中的位置
            "size": "", //每页展示的数据的条数（每页展示几条数据）
            "current": "" //当前所在的页码数（当前在第几页）
        }
        if (_this.selectInterfaceArr != undefined) {
            _this.getSearchDataFunc()
        }
        if (_this.mainFormSelectInterfaceArr != undefined) {
            _this.getFormSelectDataFunc()
        }
        if (_this.mainLinkageSelectInterfaceArr != undefined) {
            _this.getLinkageSelectDataFunc()
        }
        _this.getTableDataFunc(function () {
            _this.loadTablePager()
        });
    },
    methods: {
        // 上传取消按钮
        closeUploadModalFunc: function () {
            var _this = this;
            for (let x in _this.files) {
                delete _this.files[x];
            }
            layer.close(_this.layerBox)
        },
        /*
       * author: linzijian
       * description: 封装admin请求方便在父类中使用
       * time: 2020/09/22
       */
        adminReports(url, data, Func, callBack) {
            layuiEvent.admin.req(url, data, function (res) {
                if (res.ok) {
                    callBack && callBack(res);
                } else {
                    layerInfo(res.message, 2);
                }
            }, {method: Func})
        },
        uploadsubmitbtn: function () {
            let _this = this;
            if (_this.uploadFileName == '') {
                layerInfo('请选择需要上传的文件！', 5);
            }
        },
        /*
        * author: zhangqi
        * description:加载时间选择器的方法
        * time: 2020/09/21
        */
        loadDataTimePickerFunc: function (type, domId) {
            layuiEvent.laydate.render({
                elem: domId ? domId : '#chooseTime',//通过id绑定html中插入的end
                type: type ? type : 'date',
                min: "1970-1-1",//设置min默认最小值
                isInitValue: true,
                // value: '1989-10-14',
            });
        },

        /*
        * author: zhangqi
        * description: 获取页面顶部查询条件中，下拉菜单类型的查询条件中的所有数据，这个方法在此js中封装，
        *              可以简化前端页面的代码重复性，当选择好下拉菜单中的数据后，点击查询可以直接根据查询条件获取表格数据
        * time: 2020/09/22
        */
        getSearchDataFunc: function () {
            var _this = this;
            _this.selectInterfaceArr.forEach(function (ss) {
                $.each(ss, function (key, val) {
                    if (val) {
                        layuiEvent.admin.req(val, {}, function (res) {
                                if (res.ok) {
                                    res.data.forEach(function (item) {
                                        $('#' + key).append("<option value='" + item + "'>" + item + "</option>");
                                        layuiEvent.form.render("select");
                                    })
                                    layuiEvent.form.on('select(' + key + ')', function (data) {//对应lay-filter
                                        _this.searchParam[key] = data.value;
                                    })
                                } else {
                                    layerInfo(res.message, 2);
                                }
                            }, {method: 'GET'}
                        );
                    } else {
                        //如果下拉菜单属于选择‘是或否’，或是选择‘时间’的类型，这种类型的是直接在前端定义好选项的，但是没有定义接口路径
                        //这样的情况在，在当前的这个方法中就是没有参数val，所以执行else中的方法，直接监听在前端定义好内容的下拉菜单的选的内容，
                        //赋值给前端定义的_this.searchParam对象中对应的变量
                        layuiEvent.form.on('select(' + key + ')', function (data) {//对应lay-filter
                            _this.searchParam[key] = data.value;
                        })
                    }
                })
            })
        },

        /*
        * author: zhangqi
        * description: 获取新增或编辑的表单中，下拉菜单类型的查询条件中的所有数据，这个方法在此js中封装，
        *              可以简化前端页面的代码重复性，当选择好下拉菜单中的数据后，这样操作还可以直接获取选择的数据，传入接口中（单一下拉）
        * time: 2020/09/22
        */
        getFormSelectDataFunc: function () {
            var _this = this;
            _this.mainFormSelectInterfaceArr.forEach(function (ss) {
                if (ss.name) {
                    layuiEvent.admin.req(ss.url, {}, function (res) {
                            if (res.ok) {
                                for (let key in res.data) {
                                    if (key == ss.name) {
                                        ss.data = res.data[key]
                                    }
                                }
                                ss.data.forEach(function (item) {
                                    $('#' + ss.name).append("<option value='" + item + "'>" + item + "</option>");
                                    layuiEvent.form.render("select");
                                });
                                // if(ss.linkageUrl){
                                //     layuiEvent.admin.req(ss.linkageUrl, {stage:data.value}, function (res) {
                                //         if (res.ok) {
                                //             res.data.forEach(function (item) {
                                //                 $('#' + ss.childSelectName).append("<option value='" + item + "'>" + item + "</option>");
                                //                 layuiEvent.form.render("select");
                                //             })
                                //         } else {
                                //             layerInfo(res.message, 2);
                                //         }
                                //     }, {method: 'GET'});
                                // }
                            } else {
                                layerInfo(res.message, 2);
                            }
                        }, {method: 'GET'}
                    );
                    if (ss.linkageUrl) {
                        layuiEvent.form.on('select(form_' + ss.name + ')', function (data) {
                            if (data.value) {
                                layuiEvent.admin.req(ss.linkageUrl, {
                                    master: data.value,
                                    type: ss.type
                                }, function (res) {
                                    if (res.ok) {
                                        $('#' + ss.childSelectName).html("");
                                        $('#' + ss.childSelectName).append("<option value=''>请选择</option>");
                                        res.data.forEach(function (item) {
                                            $('#' + ss.childSelectName).append("<option value='" + item + "'>" + item + "</option>");
                                            layuiEvent.form.render("select");
                                        })
                                    } else {
                                        layerInfo(res.message, 2);
                                    }
                                }, {method: 'GET'});
                            } else {
                                $('#' + ss.childSelectName).html("");
                                $('#' + ss.childSelectName).append("<option value=''>请选择</option>");
                                layuiEvent.form.render("select");
                            }

                            layuiEvent.form.render("select");
                        })
                    }
                } else {
                    $.each(ss, function (key, val) {
                        layuiEvent.admin.req(val, {}, function (res) {
                                if (res.ok) {
                                    res.data.forEach(function (item) {
                                        $('#' + key).append("<option value='" + item + "'>" + item + "</option>");
                                        layuiEvent.form.render("select");
                                    })
                                } else {
                                    layerInfo(res.message, 2);
                                }
                            }, {method: 'GET'}
                        );
                    })
                }

            })
        },

        /*
        * author: linzijian
        * description: 获取新增或编辑的表单中，下拉菜单类型的查询条件中的所有数据，这个方法在此js中封装，
        *              可以简化前端页面的代码重复性，当选择好下拉菜单中的数据后，这样操作还可以直接获取选择的数据，传入接口中（联动下拉）
        * time: 2020/09/22
        */
        getLinkageSelectDataFunc: function () {
            var _this = this;
            _this.mainLinkageSelectInterfaceArr.forEach(function (ss) {
                _this.getLinkageData(ss);
            })
        },
        // 联动递归
        getLinkageData: function (ss, data) {
            var _this = this;
            var searchData = {};
            $.each(ss, function (key, val) {
                if (data) {
                    searchData[val.fieldIdentifier] = data;
                } else if (val.requestData) {
                    searchData = val.requestData;
                }
                if (!val.url) {
                    return
                }
                layuiEvent.admin.req(val.url, searchData, function (res) {
                        if (res.ok) {
                            $('#' + key).html('<option value=""> 请选择 </option>');
                            if (val.clearDomID) {
                                val.clearDomID.forEach(function (item) {
                                    $('#' + item).html('<option value=""> 请选择 </option>');
                                })
                            }
                            layuiEvent.form.render("select");
                            res.data.forEach(function (item) {
                                $('#' + key).append("<option value='" + item[val.value] + "'>" + item[val.name] + "</option>");
                                layuiEvent.form.on('select(' + key + ')', function (data) {//对应lay-filter
                                    if (val.echoSelectId) {
                                        $('#' + val.echoSelectId).val(data.value);
                                    }
                                    if (val.children) {
                                        val.children.forEach(function (ss) {
                                            _this.getLinkageData(ss, data.value);
                                        })
                                    }
                                    layuiEvent.form.render("select");
                                })
                                layuiEvent.form.render("select");
                            })
                        } else {
                            layerInfo(res.message, 2);
                        }
                    }, {method: val.requestType}
                );
            })
        },

        /*
        * author: linzijian
        * description: 获取新增或编辑的表单中，下拉菜单类型的查询条件中的所有数据，这个方法在此js中封装，
        *              可以简化前端页面的代码重复性，当选择好下拉菜单中的数据后，这样操作还可以直接获取选择的数据，传入接口中（联动下拉回显）
        * time: 2020/09/22
        */
        echoLinkageDataFunc: function (data) {
            var _this = this;
            if (_this.mainLinkageData) {
                _this.mainLinkageData.forEach(function (ss) {
                    _this.getLinkageData1(ss, data);
                })
            }
        },
        // 联动递归
        getLinkageData1: function (ss, data) {
            $.each(ss, function (key, val) {
                var requestdata = {};
                requestdata[val.requestDataName] = data[val.requestDataName];
                layuiEvent.admin.req(val.url, requestdata, function (res) {
                        if (res.ok) {
                            $('#' + key).html('<option value=""> 请选择 </option>');
                            $('#' + val.clearDomID).html('<option value=""> 请选择 </option>');
                            res.data.forEach(function (item) {
                                $('#' + key).append("<option value='" + item[val.value] + "'>" + item[val.name] + "</option>");
                            });
                            layuiEvent.form.on('select(' + key + ')', function (data) {//对应lay-filter
                                if (val.echoSelectId) {
                                    $('#' + val.echoSelectId).val(data.value);
                                }
                                if (val.children) {
                                    val.children.forEach(function (ss) {
                                        _this.getLinkageData1(ss, data.value);
                                    })
                                }
                                layuiEvent.form.render("select");
                            })
                            layuiEvent.form.render("select");
                            layuiEvent.form.val('example', data);
                        } else {
                            layerInfo(res.message, 2);
                        }
                    }, {method: val.requestType}
                );
            })
        },
        /*
        * author: zhangqi
        * description: 根据查询条件，调用接口，查询并获取表格数据
        * time: 2020/09/21
        */
        getTableDataFunc: function (callback) {
            var _this = this;
            _this.tableData = {};
            layuiEvent.admin.req(_this.getTableDataUrl, _this.searchParam, function (res) {
                    if (res.ok) {
                        _this.tableData = res.data.records;
                        _this.total = res.data.total;
                        _this.pageSize = res.data.size;
                        // searchViceObjParam.id = res.data.records[0].id;
                        //将全局变量传入中间组件transferParam中，用于查询副表格数据
                        // transfer.$emit('transferParam', searchViceObjParam);//TODO初始化页面子表默认展示主表第一条数据
                        //执行拼接绘制渲染表格的方法
                        _this.drawTableFunc();

                    } else {
                        layerInfo(res.message, 2);
                    }
                    callback && callback();
                }, {method: 'GET'}
            )
        },

        /*
        * author: zhangqi
        * description: 点击查询按钮执行的方法
        * time: 2020/09/22
        */
        searchDataFunc: function () {
            var _this = this;
            _this.searchParam.size = 20;
            _this.searchParam.current = 1;
            _this.getTableDataFunc(function () {
                _this.loadTablePager()
            })
        },

        /*
         * author: zhangqi
         * description: 重置查询条件
         * time: 2020/09/22
         */
        resetSearchParamFunc: function (mustparameter) {
            var _this = this;

            Object.keys(_this.searchParam).forEach(function (item) {

                _this.searchParam[item] = '';
            })
            layuiEvent.laydate.render({
                elem: '#seachHapTime'
                , value: ''
                , isInitValue: true //是否允许填充初始值，默认为 true
            });
            // 添加搜索请求毕传参数
            $.each(mustparameter, function (key, val) {
                _this.searchParam[key] = val;
            })
            _this.getTableDataFunc(function () {
                _this.loadTablePager()
            })
        },
        resetSearchParamFunc1: function (mustparameter) {
            var _this = this;

            Object.keys(_this.searchParam).forEach(function (item) {
                if (item != 'type') {
                    _this.searchParam[item] = '';
                }

            })
            // 添加搜索请求毕传参数
            $.each(mustparameter, function (key, val) {
                _this.searchParam[key] = val;
            })
            _this.getTableDataFunc(function () {
                _this.loadTablePager()
            })
        },

        /*
        * author: zhangqi
        * description: 拼接绘制渲染表格
        * time: 2020/09/16
        */
        drawTableFunc: function () {
            var _this = this;
            _this.tableColumn = [];
            _this.columnObjArr = [];
            //判断表格是否开启多选列，如果开启在表格中添加多选列
            if (_this.isCheckBox) {
                _this.tableColumn.push({type: 'checkbox'})
            }
            //判断表格是否开启序号列，如果开启在表格中添加序号列
            if (_this.isNumber) {
                _this.tableColumn.push({type: 'numbers', title: '序号', event: 'setSign'})
            }

            //判断表格是否开启操作列，如果开启在表格中添加操作列
            // if (_this.operationBtnList.length != 0) {
            //     var text = '';
            //     _this.operationBtnList.forEach(function (item) {
            //         return text += "<button  type='' class='" + item.classed + "' lay-event= " + item.trigger + " > " + item.name + " </button>"
            //     })
            //     _this.tableColumn.push(
            //         {
            //             title: _this.operationText,
            //             align: _this.align,
            //             fixed: _this.operationFixed,
            //             templet: function (res) {
            //                 return text
            //             }
            //         }
            //     )
            // }

            // 循环表头数据，整合绘制表格所需要的数据格式
            _this.headData.forEach(function (item) {
                _this.columnObj = {title: item, align: _this.align, event: 'setSign'}
                if (_this.templetList != undefined) {
                    _this.columnObj.templet = _this.templetList[item];
                }
                _this.columnObjArr.push(_this.columnObj);
                _this.columnObj = {};
            });
            // 循环数据字段的数组，赋值给中间变量数组中的字段，整合绘制表格所需要的数据格式
            _this.fieldData.forEach(function (item, index) {
                _this.columnObjArr[index].field = item;
            });
            // 循环数据字段的宽度数组，赋值给中间变量数组中的字段，添加没列宽度
            if (_this.columnWidth) {
                _this.columnWidth.forEach(function (item, index) {
                    if (item !== '') {
                        _this.columnObjArr[index].width = item;
                    }
                });
            }
            // 循环是否固定列的数组，赋值给中间变量数组中的字段，整合绘制表格所需要的数据格式
            if (_this.fixedColumn != undefined) {
                _this.fixedColumn.forEach(function (item, index) {
                    _this.columnObjArr[index].fixed = item;
                });
            }
            // 循环中间变量数组，将数组中的每一条数据添加进新的数组中，然后新的数组是表格所需要的并且已经整理好格式的数据
            _this.columnObjArr.forEach(function (item) {
                _this.tableColumn.push(item)
            });

            layui.use('table', function () {
                _this.table = layui.table
                //展示已知数据
                _this.table.render({
                    elem: '#main_table',
                    data: _this.tableData,
                    cols: [_this.tableColumn],
                    cellMinWidth: 120,
                    height: 431,
                    limit: _this.pageSize,
                });

                //点击主表格内单元格时触发的方法
                _this.rowInLineOperationFunc();
            });
        },

        /**
         * author: zhangqi
         * description: 加载表格分页
         * time: 2020/09/17
         */
        loadTablePager: function () {
            var _this = this;
            layuiEvent.laypage.render({
                elem: 'tablePager',
                count: _this.total,
                layout: ['count', 'limit', 'prev', 'page', 'next', 'skip'],
                prev: '<em><i class="layui-icon" style="font-size: 20px"><</i></em>',
                next: '<em><i class="layui-icon" style="font-size: 20px">></i></em>',
                jump: function (obj) {
                    _this.searchParam.size = obj.limit;
                    _this.searchParam.current = obj.curr;
                    _this.getTableDataFunc();
                }
            });
        },


        /*
        * author: zhangqi
        * description: 点击主表格内单元格时触发的方法
        * time: 2020/09/17
        */
        rowInLineOperationFunc: function () {
            var _this = this;
            //表格行内的操作，包括获取表格单行的数据，表格单行中‘编辑’或‘删除’的方法
            _this.table.on('tool(main_test)', function (obj) {
                var data = obj.data;
                if (obj.event === 'setSign' && _this.isShow) {
                    //将全局变量传入中间组件transferParam中，用于查询副表格数据
                    searchViceObjParam.id = data.id;
                    searchViceObjParam.parentData = data;
                    transfer.$emit('transferParam', searchViceObjParam);
                } else {
                    _this.$emit('tableoperation', obj);
                }
            });
        },


        /**
         * description:点击表格上方‘新增’按钮执行的方法
         * author:zhangqi
         * time: 2020-09-16
         */
        addDataFunc: function (size, dateType, domId) {
            var _this = this;
            _this.loadDataTimePickerFunc(dateType, domId);
            size = size || _this.size;
            //给表单中提交方法的类型的变量赋值, 判断是新增方法,还是编辑方法, 1-新增 2-编辑
            _this.submitFormType = 1;
            //清空表单中所有内容，
            document.getElementById("layui-form").reset();
