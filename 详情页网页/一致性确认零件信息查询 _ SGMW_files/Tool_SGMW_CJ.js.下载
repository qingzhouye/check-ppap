                            closeBtn: 1,
                            area: ['450px', '300px'],
                            shade: false,
                            shadeClose: false,
                            content: $("#Confirm-status-hang")
                        });
                    } else {

                    }
                } else {
                    _this.$emit('tableoperation', obj);
                }
            });
