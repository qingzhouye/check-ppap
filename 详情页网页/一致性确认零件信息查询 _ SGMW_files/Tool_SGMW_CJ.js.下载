                    let d = obj.data
                    _this.contentadd = d
                    if ((d.stockInTransitHexi <= 2 || d.stockInTransitBaojun <= 2 ||
                        d.stockInTransitQingdao <= 2 || d.stockInTransitChongqing <= 2)
                        && (d.availableDaysHexi <= 2 || d.availableDaysBaojun <= 2 ||
                            d.availableDaysQingdao <= 2 || d.availableDaysChongqing <= 2)
                        && d.dailyRiskStatus != 1) {
                        _this.layerBox = layer.open({
