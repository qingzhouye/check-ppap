        /**
         * author: zhangqi
         * description: 加载选择文件的选择框的方法
         * time: 2020/09/28
         */
        loadChooseFileCheckBoxFunc: function () {
            var _this = this;
            if (_this.uploadDom) {
                return
            }
            _this.uploadDom = layuiEvent.upload.render({
                elem: '#chooseFile',
                url: _this.uploadFileUrl, //改成您自己的上传接口
                auto: false,
                accept: 'file', //普通文件
                acceptMime: '.xls,.xlsx', //选择文件时，过滤掉这三种文件之外的所有文件
                exts: 'xls|xlsx', //允许上传文件的格式
                size: 51200, //限制文件大小，最大为50MB的文件，此处单位是KB
                bindAction: '#test9',
                choose: function (obj, index) {
                    _this.files = obj.pushFile(); //将每次选择的文件追加到文件队列
                    //读取本地文件
                    obj.preview(function (index, file, result) {
                        _this.uploadFileName = file.name;
                    });
                },
                done: function (res, index) {
                    if (res.ok) {
                        layerInfo("文件上传成功", 1);
                        layer.close(_this.layerBox);
                        // delete files[index];
                        //执行查询表格数据的方法
                        _this.getTableDataFunc(function () {
                            _this.loadTablePager()
                        })
                    } else {
                        layerInfo(res.message, 2);
                        layer.close(_this.layerBox);
                    }
                    //删除数组文件中上传成功的图片，防止重复上传（重点）
                    for (let x in _this.files) {
                        delete _this.files[x];
                    }
                },
                error: function () {
                    //删除数组文件中上传成功的图片，防止重复上传（重点）
                    for (let x in _this.files) {
                        delete _this.files[x];
                    }
                }
            });
        },
        closeUploadModal: function () {
            var _this = this;
            for (let x in _this.files) {
                delete _this.files[x];
            }
            layer.close(_this.layerBox);
        },
        /**
         * author: zhangqi
         * description: 导出文件的方法
         * time: 2020/10/14
         */
        exportItemInfo: function (fileName) {
            var _this = this;
            var exportObj = {};
            //获取表格中被勾选的数据的集合
            var checkStatus = _this.table.checkStatus('main_table')
            var data = checkStatus.data;
            //获取每条数据的id，并添加进新的数组中
            exportObj.exportVOList = []
            exportObj = JSON.parse(JSON.stringify(_this.searchParam));
            exportObj.exportVOList = []
            data.forEach(function (item) {
                let obj = {
                    partName: item.partName,
                    partNumber: item.partNumber,
                    dailyRiskStatus: item.dailyRiskStatus
                };
                exportObj.exportVOList.push(obj);
            });
            fetch(_this.exportDataUrl, {
                method: 'post',
                headers: {
                    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
                    'Content-Type': 'application/json',
                    "type":"CASTGC",
                    "CASTGC": layui.config.CASTGC,
                },
                'credentials': 'include',
                body: JSON.stringify(exportObj),
            })
                .then(res => res.blob())
                .then(blob => {
                    var a = document.createElement('a');
                    var url = window.URL.createObjectURL(blob);
                    a.href = url;
                    a.setAttribute("download", fileName + _this.currentDate+ '.xlsx');
                    a.click();
                    window.URL.revokeObjectURL(url);
                })
        },
