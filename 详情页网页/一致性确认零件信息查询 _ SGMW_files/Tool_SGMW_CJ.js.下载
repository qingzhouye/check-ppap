         * author: zhangqi
         * description: 导出文件的方法
         * time: 2020/10/14
         */
        exportItemInfo: function (fileName) {
            var _this = this;
            var exportObj = {};
            //获取表格中被勾选的数据的集合
            var checkStatus = _this.table.checkStatus('main_table')
            var data = checkStatus.data;
            //获取每条数据的id，并添加进新的数组中
            exportObj.exportVOList = []
            exportObj = JSON.parse(JSON.stringify(_this.searchParam));
            exportObj.exportVOList = []
            data.forEach(function (item) {
                let obj = {
                    partName: item.partName,
                    partNumber: item.partNumber,
                    dailyRiskStatus: item.dailyRiskStatus
                };
                exportObj.exportVOList.push(obj);
            });

            fetch(_this.exportDataUrl, {
                method: 'POST',
                headers: {
                    // 'responseType': 'blob',
                    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
                    'Content-Type': 'application/json',
                    "type":"CASTGC",
                    "CASTGC": layui.config.CASTGC,
                },
                'credentials': 'include',
                body: JSON.stringify(exportObj),
                //body: exportObj.toString()
            })
                .then(res => res.blob())
                .then(res => {
                    console.log(res);
                    const blob = new Blob([res], { type: 'application/zip' });
                    console.log(blob);
                    var a = document.createElement('a');
                    var url = window.URL.createObjectURL(blob);
                    a.href = url;
                    a.setAttribute("download", fileName);
                    a.click();
                    window.URL.revokeObjectURL(url);
                })
        },
    },
});

