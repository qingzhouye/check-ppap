            _this.columnObjArrFour.forEach(function (item) {
                _this.tableColumnFour.push(item)
            });
            _this.renderFourTable(searchData, obj);
        },
        //渲染第四个表格（子表）
        renderFourTable: function (searchData, obj) {
            var _this = this;
            //整理查询条件
            _this.searchData = searchData;
            var data = _this.reqData.searchDataFormat(searchData, _this.topNowEnumLeft, _this.topNowEnumRight);
