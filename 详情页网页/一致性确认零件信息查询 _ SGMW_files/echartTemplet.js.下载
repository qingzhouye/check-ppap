        '</div>' +
        '</div>'
    ,
    created() {
        var _this = this;
        _this.echartData = JSON.parse(JSON.stringify(_this.echartData));
        _this.showTitleTime();
    },
    mounted: function () {
        var _this = this;
        _this.initEchartDom();
        _this.initClickList();
    },
    updated() {
        var _this = this;
    },
    methods: {
        showTitleTime: function () {
            var _this = this;
            if (!_this.searchData) {
                _this.searchStartDate = new Date().toLocaleDateString();
                _this.searchEndDate = new Date().toLocaleDateString();
            }

        },

        //辅助函数，将2021年8月第2周格式转换成2021-08-08
        dateTransition: function (week) {
            let time = '';
            let i = 0;
            const reg = new RegExp('\\d+', 'g');
            // 返回的是所有的数字组成的数组
            const dataArr = week.match(reg);
            // 获取到年份
            const year = dataArr[0];
            // 获取到月份
            let month = +dataArr[1] < 10 ? '0' + dataArr[1] : dataArr[1];
            // 获取到当前月份的第几周
            const weeks = dataArr[2];
            //获取到当前月的最后一天
            const currentMonthLast = new Date(year, month, 0).getDate();
            // 年月的拼接 2021-08-
            let yearMonth = year + '-' + month + '-';
            for (let j = 1; j <= currentMonthLast; j++) {
                // 返回的是该日期对应的星期（0对应周日）
                if (j < 10) {
                    j = '0' + j;
                }
                let day = new Date(`${yearMonth + j}`).getDay();
                if (day != 0) {
                    continue;
                }
                i++;
                if (weeks == i) {
                    time = yearMonth + j;
                }
            }
            return time;
        },
        // 初始化echartdom
        initEchartDom: function () {
            var _this = this;
            if (_this.tableOrEchart == 'echart') {
                _this.echartDom = echarts.init(document.getElementById('echart-' + _this.tabBarType + '-' + _this.echartId));
                //代表的是第三个tab签的图 0 1 2
                if (_this.tabBarType == '2' && _this.menuName == 'ADC_stwl_gysscyy_gysscyy_zlyx') {  //质量运行页面
                    _this.echartDom.on('click', function (params) {
                        if (_this.echartId == '0') {//第一个统计图
                            let searchstart = '',
                                searchend ='';
                            let year = params.name.substring(0, 4);
                            let month = params.name.substring(4, 6);
                            let currentMonthLast = new Date(year, month, 0).getDate();
                            if (_this.searchData.dateType.dateType == 'day' && params.name.length == 8) {
                                // 20210902
                                searchstart = year + '-' + month + '-' + params.name.substring(6, 8);
                                searchend = year + '-' + month + '-' + params.name.substring(6, 8);
                            } else if (_this.searchData.dateType.dateType == 'month' && params.name.length == 6){
                                // 202109
                                searchstart = year + '-' + month + '-01';
                                searchend = year + '-' + month + '-' + currentMonthLast;
                            } else {
                                //2021年6月第3周
                                searchstart = _this.dateTransition(params.name);
                                let end = new Date(searchstart).getTime() + (24 * 60 * 60 * 1000) * 6;
                                var data = new Date(end);
                                var yy = data.getFullYear();
                                var mm = data.getMonth() + 1 > 10 ? data.getMonth() + 1 : '0' + (data.getMonth() + 1);
                                var dd = data.getDate() > 10 ? data.getDate() : '0' + data.getDate();
                                searchend = yy + '-' + mm + '-' + dd;
                            }
                            _this.searchData.searchStartDate = searchstart;
                            _this.searchData.searchEndDate = searchend;
                        } else if (_this.echartId == '1') {
                            _this.searchData.supplierCode = params.name;   //供应商代码
                        }
                        // _this.getDataReq(_this.searchData);
                        _this.renderColume(_this.searchData);
                    })
                }
            } else if (_this.tableOrEchart == 'table') {
                var _this = this;
                _this.tableColumn = [];
                _this.columnObjArr = [];
                _this.tableColumn.push({type: 'numbers', title: '序号', width: '4%'})
                // 循环表头数据，整合绘制表格所需要的数据格式
                _this.tableSet.set.forEach(function (item) {
                    _this.columnObj = {
                        title: item.title,
                        align: "center",
                        field: item.field,
                        width: item.width,
                        templet: item.templet,
                    }
                    _this.columnObjArr.push(_this.columnObj);
                    _this.columnObj = {};
                });
                // 循环中间变量数组，将数组中的每一条数据添加进新的数组中，然后新的数组是表格所需要的并且已经整理好格式的数据
                _this.columnObjArr.forEach(function (item) {
                    _this.tableColumn.push(item)
                });
            }
        },
        //生成表格的表头
        renderColume: function (searchData) {
