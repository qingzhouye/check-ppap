                    //拿到数据绘制第三个表格
                    layui.use('table', function () {
                        var table = layui.table;
                        _this.titleDate = objData.time;
                        //展示已知数据
                        table.render({
                            elem: '#echart-2-2',
                            data: objData.tableData,
                            cols: [_this.tableColumn],
                            width: $('#echart-content-2-2').width(),
                            height: $('#echart-content-2-2').height(),
                            limit: 999999,
                        });
                        if (objData.tableData.length == 0) {

                        } else {
                            _this.renderFourColume(searchData, objData.tableData[0]);
                        }
                        _this.rowInLineOperationFunc(searchData);
                    });
                } else {
                    layerInfo(res.message, 2);
                }
                layuiEvent.admin.removeLoading();
            }, {method: 'GET'})
        },
        //点击表格行更新子表
        rowInLineOperationFunc: function (searchData) {
            var _this = this;
            layui.table.on('row(echart-2-2)', function (obj) {
                //取到点击行的数据，渲染子表
                _this.renderFourColume(searchData, obj);
            });
        },
        //生成表格的表头
        renderFourColume: function (searchData, obj) {
            var _this = this;
            var coloum = [{
                    title: '检查项目',
                    align: "center",
                    field: 'chkobj',
                    width: '25%',
                    templet: null,
                },
                    {
                        title: '判定标准',
                        align: "center",
                        field: 'standar',
                        width: '25%',
                        templet: null,
                    },

                    {
                        title: '不合格数',
                        align: "center",
                        field: 'ngcount',
                        width: '25%',
                        templet: null,
                    },
                    {
                        title: '主要问题',
                        align: "center",
                        field: 'discription',
                        width: '24%',
                        templet: null,
                    },
