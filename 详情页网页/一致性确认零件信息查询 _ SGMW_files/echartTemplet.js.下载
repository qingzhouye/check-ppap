        },

        getenum: function (url, flage) {
            var _this = this;
            var num = flage == 'Right' ? 1 : 0;
            layuiEvent.admin.req(url, {}, function (res) {
                if (res.ok) {
                    var obj = {}
                    if (_this.title == '变化点TOP供应商分析'){
                        res.data.unshift({value: "全部", key: ''})
                    }
                    res.data.forEach((e, i) => {
                        obj[e.key] = {
                            Name: e.key,
                            Type: e.key,
                            TypeNumber: i
                        }
                    });
                    $.each(obj, (key, val) => {
                        _this.clickList[num].push(val)
                    })
                    if (_this.title == '变化点TOP供应商分析'){
                        _this.clickList[num][0].Name = "全部"
                    }
                    _this['topNowEnum' + flage] = _this.clickList[1][0];
                    _this['operationFlage' + flage] = true;
                } else {
                    layerInfo(res.message, 2);
                }
                layuiEvent.admin.removeLoading();
            }, {method: 'GET'})
        },
        // 初始化点击list
        initClickList: function () {
            var _this = this;
            if (typeof _this.operationEnumLeft == 'string') {
                _this.operationFlageLeft = false;
                _this.getenum(_this.operationEnumLeft, 'Left');
            } else {
                $.each(_this.operationEnumLeft, (key, val) => {
                    _this.clickList[0].push(val)
                })
                _this.topNowEnumLeft = _this.clickList[0][0];
            }
            if (typeof _this.operationEnumRight == 'string') {
                _this.operationFlageRight = false
                _this.getenum(_this.operationEnumRight, 'Right');
            } else {
                $.each(_this.operationEnumRight, (key, val) => {
                    _this.clickList[1].push(val)
                })
                _this.topNowEnumRight = _this.clickList[1][0];
            }
        },
        leftClick: function (item, index) {
            var _this = this;
            _this.topNowEnumLeft = item;
            _this.getDataReq(_this.searchData);
        },
        rightClick: function (item, index) {
            var _this = this;
            _this.topNowEnumRight = item;
            _this.getDataReq(_this.searchData);
        },
        // 重置方法
        resetSearchFunc: function () {
            var _this = this;
            if (_this.operationFlageLeft) {
                _this.topNowEnumLeft = _this.clickList[0][0];
            }
            if (_this.operationFlageRight) {
                _this.topNowEnumRight = _this.clickList[1][0];
            }
        },
        // 刷新echart图方法
        resetEchart: function (data) {
            var _this = this;
            _this.titleDate = data.time;
            if (_this.tableOrEchart == 'echart') {
                _this.echartDom.setOption(data.echartData, true);
                _this.echartDom.resize();
            } else if (_this.tableOrEchart == 'table') {
                layui.use('table', function () {
                    var table = layui.table;
                    _this.titleDate = data.time;
                    //展示已知数据
                    table.render({
                        elem: '#echart-' + _this.tabBarType + '-' + _this.echartId,
                        data: data.tableData,
                        cols: [_this.tableColumn],
                        width: $('#echart-content-' + _this.tabBarType + '-' + _this.echartId).width(),
                        height: $('#echart-content-' + _this.tabBarType + '-' + _this.echartId).height(),
                        limit: 999999,
                        done: function () {
                            if (_this.tabBarType == '2' && _this.echartId == '2' && _this.menuName == 'ADC_stwl_gysscyy_gysscyy_zlyx') {
                                _this.rowInLineOperationFunc(_this.searchData);
                            }
                        }
                    });
                });
            }
        },
        // 请求展示图数据方法
        getDataReq: function (searchData) {
            var _this = this;
            _this.searchData = searchData
            if (_this.tableOrEchart == 'echart') {
                var data = _this.reqData.searchDataFormat(searchData, _this.topNowEnumLeft, _this.topNowEnumRight);
                layuiEvent.admin.req(_this.reqData.reqUrl, data, function (res) {
                    if (res.ok) {
                        // _this.echartData = ;'tabBarType', 'echartId',
                        if (_this.tabBarType == '2' && _this.echartId == '0' && _this.menuName == 'ADC_stwl_gysscyy_gysscyy_zlyx') {
                            //将第三个tab签的第一个统计图数据保存下来
                            _this.firstEcharts = res.data;
                        }
                        _this.resetEchart(_this.reqData.reqDataFormat(res.data, _this.echartData, _this.topNowEnumLeft, _this.topNowEnumRight, res));
                    } else {
                        layerInfo(res.message, 2);
                    }
                    layuiEvent.admin.removeLoading();
                }, {method: _this.reqData.reqType})
            } else if (_this.tableOrEchart == 'table') {
                if (_this.defaultVal) {
                    searchData.id = _this.defaultVal;
                }
                var data = _this.reqData.searchDataFormat(searchData, _this.topNowEnumLeft, _this.topNowEnumRight);
                layuiEvent.admin.req(_this.reqData.reqUrl, data, function (res) {
                    if (res.ok) {
                        // _this.tableSet.tableData = ;
                        if (_this.tabBarType == '2' && _this.echartId == '2' && _this.menuName == 'ADC_stwl_gysscyy_gysscyy_zlyx') {
                            if (res.data.list.length != 0) {
                                // 将第三个tab签的第三个图的数据保存下来
                                _this.$emit('changeya', res.data.list[0].chkcode);
                            } else {
                                _this.renderFourColume(searchData, false);
                            }
                        }
                        _this.resetEchart(_this.reqData.reqDataFormat(res, _this.echartData, _this.topNowEnumLeft, _this.topNowEnumRight));
                    } else {
                        layerInfo(res.message, 2);
                    }
                    layuiEvent.admin.removeLoading();
                }, {method: _this.reqData.reqType})
            }
            // _this.resetEchart();
        },
        //导出方法
        exportDataFunc: function () {
            var _this = this
            var myDate = new Date();
            var year = myDate.getFullYear(); //获取完整的年份(4位,1970-????)
            var month = myDate.getMonth() + 1 < 10 ? '0' + (myDate.getMonth() + 1) : myDate.getMonth() + 1; //获取当前月份(0-11,0代表1月)
            var date = myDate.getDate(); //获取当前日(1-31)
            var currentDate = year + '' + month + '' + date //拼接组成当前时间
            var exportObj = {}
            exportObj = JSON.parse(JSON.stringify(searchDatafotmat_two(_this.searchData)));
            //exportObj.dateType = exportObj.dateType.dateType
            fetch(_this.exportUrl, {
                method: 'post',
                headers: {
                    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
                    'Content-Type': 'application/json'
                },
                'credentials': 'include',
                body: JSON.stringify(exportObj),
            })
                .then(res => res.blob())
                .then(blob => {
                    var a = document.createElement('a');
                    var url = window.URL.createObjectURL(blob);
                    a.href = url;
                    a.setAttribute("download", currentDate + '.xlsx');
                    a.click();
                    window.URL.revokeObjectURL(url);
                })
        },
        exportDataFunc2: function () {
            var _this = this
            var myDate = new Date();
            var year = myDate.getFullYear(); //获取完整的年份(4位,1970-????)
            var month = myDate.getMonth() + 1 < 10 ? '0' + (myDate.getMonth() + 1) : myDate.getMonth() + 1; //获取当前月份(0-11,0代表1月)
            var date = myDate.getDate(); //获取当前日(1-31)
            var currentDate = year + '' + month + '' + date //拼接组成当前时间
            var data = _this.reqData.searchDataFormat(_this.searchData, _this.topNowEnumLeft, _this.topNowEnumRight);
            let url = _this.exportUrl + '?'
            for (let key in data) {
                url += `${key}=${data[key]}&`
            }
            layui.use('layer', function () {
                    var config = layui.config;
                    var xhr = new XMLHttpRequest();
                    //GET请求,请求路径url,async(是否异步)
                // _this.exportUrl+ `?projectId=${data.projectId}&searchType=${data.searchType}&startDate=${data.startDate}&endDate=${data.endDate}&supplierName=${data.supplierName}&projectName=${data.projectName}&issueSource=${data.issueSource}&issueType=${data.issueType}`
                    xhr.open('GET',url , true);
                    //设置请求头参数的方式,如果没有可忽略此行代码
                    if (config.EDUCASTGC) {
                        xhr.setRequestHeader("EDU-CASTGC", config.EDUCASTGC);
                        xhr.setRequestHeader("type", "EDU-CASTGC");
                    } else {
                        xhr.setRequestHeader("CASTGC", config.CASTGC);
                        xhr.setRequestHeader("type", 'CASTGC');
                    }
                    //设置响应类型为 blob
                    xhr.responseType = 'blob';
                    //关键部分
                    xhr.onload = function (e) {
                        //如果请求执行成功
                        if (this.status == 200) {
                            var blob = this.response;
                            var filename = currentDate + '.xls';//如123.xls
                            var a = document.createElement('a');

                            blob.type = "application/octet-stream";
                            //创键临时url对象
                            var url = URL.createObjectURL(blob);

                            a.href = url;
                            a.download=filename;
                            a.click();
                            //释放之前创建的URL对象
                            window.URL.revokeObjectURL(url);
                        }
                    };
                    //发送请求
                    xhr.send();
                })
            // fetch(_this.exportUrl, {
            //     method: 'post',
            //     headers: {
            //         'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
            //         'Content-Type': 'application/json'
            //     },
            //     'credentials': 'include',
