            firstTable: [],
            flages: true,
        }
    },
    template:
        '<div class="echart-box">' +
        '<div class="echart-title">' +
        '<div class="title-text" style="overflow: hidden;text-overflow:ellipsis;white-space: nowrap;"> <p class="main-title" style="margin: 15px;font-weight: bold;font-size: 15px;border-left: 3px solid rgb(25,128,206);padding-left: 5px">{{title}}</p> <p class="title-date" style="margin: 15px; color:#5583FF;font-weight: bold">{{titleDate}}</p>'+
        '<div class="echart-btn" v-if="hasExportUrl">' +
        '<button class="g-btn-blue" @click="exportDataFunc()">导出</button>' +
        '</div> ' +
        '<div class="echart-btn" v-if="hasExportUrl2">' +
        '<button class="g-btn-blue" @click="exportDataFunc2()">导出</button>' +
        '</div> ' +
        '</div>' +
        '<div class="list-box">' +
        '<ul class="list-type title-operation"v-if="operationFlageLeft">' +
        ' <li v-for="(item,index) in clickList[0]" :key="index" @click="leftClick(item,index)" :class="topNowEnumLeft.TypeNumber==index?`li-click`:``">{{item.Name}}</li>' +
        '</ul>' +
        '<span></span>' +
        '<ul class="list-type title-operation" v-if="operationFlageRight">' +
        ' <li v-for="(item,index) in clickList[1]" :key="index" @click="rightClick(item,index)" :class="topNowEnumRight.TypeNumber==index?`li-click`:``">{{item.Name}}</li>' +
        '</ul>' +
        '</div>' +
        '</div>' +
        '<div class="echart-content" :id="`echart-content-${tabBarType}-${echartId}`">' +
        '<div :id="`echart-${tabBarType}-${echartId}`" style="width: 100%;height: 100%;" v-if="tableOrEchart === `echart`"></div>' +
