                    width: '20%',
                    templet: null,
                },
                {
                    title: '零件号',
                    align: "center",
                    field: 'assypartscode',
                    width: '20%',
                    templet: null,
                },
                {
                    title: '零件名称',
                    align: "center",
                    field: 'sp1',
                    width: '20%',
                    templet: null,
