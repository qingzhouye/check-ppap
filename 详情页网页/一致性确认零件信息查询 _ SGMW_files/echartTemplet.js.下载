                    const objData = {
                        tableData: res.data,
                        time: res && res.message ? res.message : ''
                    };
                    //拿到数据绘制第三个表格
                    layui.use('table', function () {
                        var table = layui.table;
                        _this.titleDate = objData.time;
                        //展示已知数据
