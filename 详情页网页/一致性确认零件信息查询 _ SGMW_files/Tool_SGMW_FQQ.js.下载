        }
    },
    template:
        '<div>' +
        '<table id="main_table" lay-filter="main_test"></table>' +
        '<div id="tablePager"></div>' +
        '<div id="layui-upload" style="display: none">' +
        '<div class="layui-upload g-layui-upload" id="aaa">' +
        '<label class="g-upload-lable"><span style="color: red;">*</span>文件:</label>' +
        '<input class="g-layui-upload-input" type="text" v-model="uploadFileName" lay-verify="required" autocomplete="off" placeholder="请上传文件" disabled>' +
        '<button type="button" class="layui-btn layui-btn-normal g-layui-upload-btn" id="chooseFile">选择文件</button>' +
        '</div>' +
        '<span class="g-layui-upload-flie-type-tips">请上传50M以内Excel格式的文件。</span>' +
        '<div class="g-layui-upload-btn-group">' +
        '<button type="submit" class="layui-btn layui-btn-normal g-layui-upload-btn" id="test9">确定</button>' +
        '<button type="button" id="close" class="layui-btn layui-btn-primary g-layui-upload-btn" @click="closeUploadModal">取消</button>' +
        '</div>' +
        '</div>' +
        '</div>',

