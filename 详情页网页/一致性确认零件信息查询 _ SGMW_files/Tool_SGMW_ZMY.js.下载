// 公用的表格和公用的方法
var mainPublicTableAndMethod = Vue.component('main-public-table-and-method-zmy', {
    /*
     * description: props参数说明
     * searchParam: 选择的查询条件的对象
     * formObjParam: 表单中存在下拉联动回显功能时 ，定义的对象变量
     * headData: 表头内容
     * fieldData: 对应字段
     * fixedColumn: 是否固定列
     * isCheckBox: 是否开启多选列
     * isNumber: 是否开启序号列
     * align: 表格内容的对齐方式  left左对齐，center居中对齐，right右对齐
     * selectInterfaceArr: 页面顶部查询条件中下拉菜单类型的查询条件的所对应的接口
     * mainFormSelectInterfaceArr: 新增或编辑的表单中下拉菜单类型的查询条件的所对应的接口
     * mainFormEchoInterfaceArr:带有下拉联动回显功能的接口
     * operationText: 带有其他操作按钮的列的列名称
     * operationBtnList: 带有其他操作按钮的列中的内容
     * getTableDataUrl: 获取主表格所有数据的接口地址
     * addOrEditTableDataUrl: 新增一条主表格数据的接口地址
     * publishTableDataUrl: 发布或提交表格数据的接口的地址
     * deleteTableDataUrl: 删除一条或多条主表格数据的接口地址
     * downloadTemplateUrl: 下载模板的接口
     * uploadFileUrl: 导入（上传）文件的接口地址
     * exportDataUrl: 导出文件的接口
     */
    props: ['searchParam', 'formObjParam', 'headData', 'fieldData', 'fixedColumn',
        'isCheckBox', 'isNumber', 'align', 'operationText', 'operationFixed', 'operationBtnList', 'columnWidth', 'templetList',
        'selectInterfaceArr', 'mainFormSelectInterfaceArr', 'mainFormEchoInterfaceArr',
        'getTableDataUrl', 'addOrEditTableDataUrl', 'publishTableDataUrl', 'deleteTableDataUrl',
        'downloadTemplateUrl', 'uploadFileUrl', 'exportDataUrl', 'exportDataByIdUrl'],
    data: function () {
        return {
            currentDate: "",
            deep_copy_searchParam: {}, //用户深度拷贝查询条件对象的数据
            table: {},
            submitFormType: "", //执行表单中提交方法的类型, 判断是新增方法,还是编辑方法, 1-新增 2-编辑
            checkedTableDataObj: {}, //此变量用于编辑功能时，存储被勾选那一条的数据对象
            tableData: [],
            columnObj: {},
            columnObjArr: [],
            tableColumn: [],
            size: ['700px', '450px'],
            layerBox: '', //定义一个弹出框的标识变量名称，这个的作用是用于在接口调用并且方法执行成功之后（例如新增或编辑方法），单独关闭所对应的提示框
            //表格分页器的对象中的变量
            pagination: {
                total: 0, //记录表格的总数据条数
                size: 20, //当前每页展示的数据的条数
                current: 1
            },
            uploadFileName: '', //选择上传的文件的文件名称
            uploadDom: null,
            files: [],
            //下拉菜单中带有分页表格的情况下，需要通过选择其中一项去筛选另一项的数据时，定义这个对象变量，作为筛选另一项的数据时的补充查询条件
            //这个变量只有在联动的情况下，作用体现的非常大，如果不需要联动功能的话，这个变量的作用非常小，甚至没用
            linkageParamObj: {}
        }
    },
    template:
        '<div>' +
        '<table id="main_table" lay-filter="main_test"></table>' +
        '<div id="tablePager"></div>' +
        '<div id="layui-upload" style="display: none">' +
        '<div class="layui-upload g-layui-upload" id="aaa">' +
        '<label class="g-upload-lable"><span style="color: red;">*</span>文件:</label>' +
        '<input class="g-layui-upload-input" type="text" v-model="uploadFileName" lay-verify="required" autocomplete="off" placeholder="请上传文件" disabled>' +
        '<button type="button" class="layui-btn layui-btn-normal g-layui-upload-btn" id="chooseFile">选择文件</button>' +
        '</div>' +
        '<span class="g-layui-upload-flie-type-tips">请上传50M以内Excel，csvl格式的文件。</span>' +
        '<div class="g-layui-upload-btn-group">' +
        '<button type="submit" class="layui-btn layui-btn-normal g-layui-upload-btn" id="test9">确定</button>' +
        '<button type="button" class="layui-btn layui-btn-primary g-layui-upload-btn" @click="closeUploadModal">取消</button>' +
        '</div>' +
        '</div>' +
        '</div>',

    mounted: function () {
        var _this = this;
        //重置用于查询副表格数据的全局变量
        searchViceObjParam = {
            "parentId": '', //主表格中被选中的一行数据的id
            "childType": 0, //tabs标签项中的位置
            "size": "", //每页展示的数据的条数（每页展示几条数据）
            "current": "" //当前所在的页码数（当前在第几页）
        }
        if (_this.selectInterfaceArr != undefined) {
            _this.getSearchDataFunc()
        }
        if (_this.mainFormSelectInterfaceArr != undefined) {
            _this.getFormSelectDataFunc()
        }
        if (_this.mainFormEchoInterfaceArr != undefined) {
            _this.getEchoSelectDataFunc()
        }
        _this.getTableDataFunc(function () {
            _this.loadTablePager()
        });

        _this.getCurrentDate();
    },
    methods: {
        /*
       * author: zhangqi
       * description:加载当前的日期的方法，用于导出文件时，给导出的文件名称添加一个导出日期的标记后缀
       * time: 2020/09/21
       */
        getCurrentDate: function () {
            var _this = this;
            var myDate = new Date();
            var year = myDate.getFullYear(); //获取完整的年份(4位,1970-????)
            var month = myDate.getMonth() + 1 < 10 ? '0' + (myDate.getMonth() + 1) : myDate.getMonth() + 1; //获取当前月份(0-11,0代表1月)
            var date = myDate.getDate(); //获取当前日(1-31)
            _this.currentDate = year + '' + month + '' + date //拼接组成当前时间
        },

        /*
        * author: zhangqi
        * description:加载时间选择器的方法
        * time: 2020/09/21
        */
        loadDataTimePickerFunc: function (type, domId) {
            layuiEvent.laydate.render({
                elem: domId ? domId : '#chooseTime',//通过id绑定html中插入的end
                type: type ? type : 'date',
                min: "1970-1-1",//设置min默认最小值
                isInitValue: true,
                // value: '1989-10-14',
            });
        },

        /*
        * author: zhangqi
        * description: 获取页面顶部查询条件中，下拉菜单类型的查询条件中的所有数据，这个方法在此js中封装，
        *              可以简化前端页面的代码重复性，当选择好下拉菜单中的数据后，点击查询可以直接根据查询条件获取表格数据
        * time: 2020/09/22
        */
        getSearchDataFunc: function () {
            var _this = this;
            _this.selectInterfaceArr.forEach(function (ss) {
                $.each(ss, function (key, val) {
                    if (val) {
                        layuiEvent.admin.req(val, {}, function (res) {
                                if (res.ok) {
                                    res.data.forEach(function (item) {
                                        $('#' + key).append("<option value='" + item + "'>" + item + "</option>");
                                        layuiEvent.form.render("select");
                                    })
                                    layuiEvent.form.on('select(' + key + ')', function (data) {//对应lay-filter
                                        _this.searchParam[key] = data.value;
                                    })
                                } else {
                                    layerInfo(res.message, 2);
                                }
                            }, {method: 'GET'}
                        );
                    } else {
                        //如果下拉菜单属于选择‘是或否’，或是选择‘时间’的类型，这种类型的是直接在前端定义好选项的，但是没有定义接口路径
                        //这样的情况在，在当前的这个方法中就是没有参数val，所以执行else中的方法，直接监听在前端定义好内容的下拉菜单的选的内容，
                        //赋值给前端定义的_this.searchParam对象中对应的变量
                        layuiEvent.form.on('select(' + key + ')', function (data) {//对应lay-filter
                            _this.searchParam[key] = data.value;
                        })
                    }
                })
            })
        },

        /*
        * author: zhangqi
        * description: 获取新增或编辑的表单中，下拉菜单类型的查询条件中的所有数据，这个方法在此js中封装，
        *              可以简化前端页面的代码重复性，当选择好下拉菜单中的数据后，这样操作还可以直接获取选择的数据，传入接口中（单一下拉）
        * time: 2020/09/22
        */
        getFormSelectDataFunc: function () {
            var _this = this;
            _this.mainFormSelectInterfaceArr.forEach(function (ss) {
                if (ss.name) {
                    layuiEvent.admin.req(ss.url, {}, function (res) {
                            if (res.ok) {
                                for (let key in res.data) {
                                    if (key == ss.name) {
                                        ss.data = res.data[key]
                                    }
                                }
                                ss.data.forEach(function (item) {
                                    $('#' + ss.name).append("<option value='" + item + "'>" + item + "</option>");
                                    layuiEvent.form.render("select");
                                });
                            } else {
                                layerInfo(res.message, 2);
                            }
                        }, {method: 'GET'}
                    );
                    if (ss.linkageUrl) {
                        layuiEvent.form.on('select(form_' + ss.name + ')', function (data) {
                            if (data.value) {
                                layuiEvent.admin.req(ss.linkageUrl, {stage: data.value}, function (res) {
                                    if (res.ok) {
                                        res.data.forEach(function (item) {
                                            $('#' + ss.childSelectName).append("<option value='" + item + "'>" + item + "</option>");
                                            layuiEvent.form.render("select");
                                        })
                                    } else {
                                        layerInfo(res.message, 2);
                                    }
                                }, {method: 'GET'});
                            } else {
                                $('#' + ss.childSelectName).html("");
                                $('#' + ss.childSelectName).append("<option value=''>请选择</option>");
                                layuiEvent.form.render("select");
                            }
                            layuiEvent.form.render("select");
                        })
                    }
                } else {
                    $.each(ss, function (key, val) {
                        layuiEvent.admin.req(val, {}, function (res) {
                                if (res.ok) {
                                    res.data.forEach(function (item) {
                                        $('#' + key).append("<option value='" + item + "'>" + item + "</option>");
                                        layuiEvent.form.render("select");
                                    })
                                } else {
                                    layerInfo(res.message, 2);
                                }
                            }, {method: 'GET'}
                        );
                    })
                }
            })
        },

        /*
         * author: zhangqi
         * description: 下拉菜单与文本框联动回显的方法
         * time: 2020/10/22
         */
        getEchoSelectDataFunc: function () {
            var _this = this;
            var str = '';
            _this.mainFormEchoInterfaceArr.forEach(function (ss) {
                $.each(ss, function (key, val) {
                    layuiEvent.form.on('select(' + key + ')', function (data) {
                        $.each(val, function (key1, val1) {
                            $.each(val1, function (key2, val2) {
                                if (data.value) {
                                    layuiEvent.admin.req(val2, {[key1]: data.value}, function (res) {
                                        if (res.ok) {
                                            _this.formObjParam[key2] = res.data[key2];
                                            // layuiEvent.form.render("select");
                                        } else {
                                            layerInfo(res.message, 2);
                                        }
                                    }, {method: 'GET'});
                                } else {
                                    _this.formObjParam[key2] = '';
                                    // layuiEvent.form.render("select");
                                }
                            });
                        });
                    })
                })
            })
        },

        /*
        * author: zhangqi
        * description: 根据查询条件，调用接口，查询并获取表格数据
        * time: 2020/09/21
        */
        getTableDataFunc: function (callback) {
            var _this = this;
            _this.tableData = {};
            //分页器对象变量
            let options = {
                "size": this.pagination.size, //每页展示多少条
                "current": this.pagination.current //current:当前选择的第几页
            };
            let params = Object.assign({}, options, _this.deep_copy_searchParam);
            layuiEvent.admin.req(_this.getTableDataUrl, params, function (res) {
                    if (res.ok) {

                        _this.tableData = res.data.records||res.data;
                        _this.pagination.total = res.data.total;
                        _this.pagination.size = res.data.size;
                        // searchViceObjParam.parentId = res.data.records[0].id;
                        //将全局变量传入中间组件transferParam中，用于查询副表格数据
                        // transfer.$emit('transferParam', searchViceObjParam);//TODO初始化页面子表默认展示主表第一条数据
                        //执行拼接绘制渲染表格的方法
                        _this.drawTableFunc();
                        callback && callback();
                    } else {
                        layerInfo(res.message, 2);
                    }
                }, {method: 'GET'}
            )
        },

        /*
        * author: zhangqi
        * description: 点击查询按钮执行的方法
        * time: 2020/09/22
        */
        searchDataFunc: function () {
            var _this = this;
            _this.pagination.current = 1;
            _this.deep_copy_searchParam = {};
            _this.deep_copy_searchParam = JSON.parse(JSON.stringify(_this.searchParam));
            _this.getTableDataFunc(function () {
                _this.loadTablePager()
            });
            //初始化副表格的tabs页签，删除主表格数据后，定位下标数是0的第一个tabs标签
            tabsIndex = 0;
            $('.layui-tab-title li').eq(0).addClass('layui-this').siblings().removeClass('layui-this')

            //重置用于查询副表格数据的全局变量
            searchViceObjParam = {
                "parentId": '', //主表格中被选中的一行数据的id
                "childType": 0, //tabs标签项中的位置
                "size": "", //每页展示的数据的条数（每页展示几条数据）
                "current": "" //当前所在的页码数（当前在第几页）
            }
            //将全局变量传入中间组件transferParam中，用于查询副表格数据
            transfer.$emit('transferParam', searchViceObjParam);
        },

        /*
         * author: zhangqi
         * description: 重置查询条件
         * time: 2020/09/22
         */
        resetSearchParamFunc: function () {
            var _this = this;
            _this.deep_copy_searchParam = {};
            _this.pagination.current = 1;
            _this.pagination.size = 20;
            Object.keys(_this.searchParam).forEach(function (item) {
                _this.searchParam[item] = '';
            })
            _this.getTableDataFunc(function () {
                _this.loadTablePager()
            });
            //初始化副表格的tabs页签，删除主表格数据后，定位下标数是0的第一个tabs标签
            tabsIndex = 0;
            //设置副表格选中一个tabs标签的样式
            $('.layui-tab-title li').eq(0).addClass('layui-this').siblings().removeClass('layui-this')
            //重置用于查询副表格数据的全局变量
            searchViceObjParam = {
                "parentId": '', //主表格中被选中的一行数据的id
                "childType": 0, //tabs标签项中的位置
                "size": "", //每页展示的数据的条数（每页展示几条数据）
                "current": "" //当前所在的页码数（当前在第几页）
            }
            //将全局变量传入中间组件transferParam中，用于查询副表格数据
            transfer.$emit('transferParam', searchViceObjParam);
        },

        /*
        * author: zhangqi
        * description: 拼接绘制渲染表格
        * time: 2020/09/16
        */
        drawTableFunc: function () {
            var _this = this;
            _this.tableColumn = [];
            _this.columnObjArr = [];
            //判断表格是否开启多选列，如果开启在表格中添加多选列
            if (_this.isCheckBox) {
                _this.tableColumn.push({type: 'checkbox'})
            }
            //判断表格是否开启序号列，如果开启在表格中添加序号列
            if (_this.isNumber) {
                _this.tableColumn.push({type: 'numbers', title: '序号', event: 'setSign'})
            }

            //判断表格是否开启操作列，如果开启在表格中添加操作列
            // if (_this.operationBtnList.length != 0) {
            //     var text = '';
            //     _this.operationBtnList.forEach(function (item) {
            //         return text += "<button  type='' class='" + item.classed + "' lay-event= " + item.trigger + " > " + item.name + " </button>"
            //     })
            //     _this.tableColumn.push(
            //         {
            //             title: _this.operationText,
            //             align: _this.align,
            //             fixed: _this.operationFixed,
            //             templet: function (res) {
            //                 return text
            //             }
            //         }
            //     )
            // }

            // 循环表头数据，整合绘制表格所需要的数据格式
            _this.headData.forEach(function (item) {
                _this.columnObj = {title: item, align: _this.align, event: 'setSign'}
                if (_this.templetList != undefined) {
                    _this.columnObj.templet = _this.templetList[item];
                }
                _this.columnObjArr.push(_this.columnObj);
                _this.columnObj = {};
            });
            // 循环数据字段的数组，赋值给中间变量数组中的字段，整合绘制表格所需要的数据格式
            _this.fieldData.forEach(function (item, index) {
                _this.columnObjArr[index].field = item;
            });
            // 循环数据字段的宽度数组，赋值给中间变量数组中的字段，添加没列宽度
            if (_this.columnWidth) {
                _this.columnWidth.forEach(function (item, index) {
                    if (item !== '') {
                        _this.columnObjArr[index].width = item;
                    }
                });
            }
            // 循环是否固定列的数组，赋值给中间变量数组中的字段，整合绘制表格所需要的数据格式
            if (_this.fixedColumn != undefined) {
                _this.fixedColumn.forEach(function (item, index) {
                    _this.columnObjArr[index].fixed = item;
                });
            }
            // 循环中间变量数组，将数组中的每一条数据添加进新的数组中，然后新的数组是表格所需要的并且已经整理好格式的数据
            _this.columnObjArr.forEach(function (item) {
                _this.tableColumn.push(item)
            });
            layui.use('table', function () {
                _this.table = layui.table
                //展示已知数据
                _this.table.render({
                    elem: '#main_table',
                    data: _this.tableData,
                    cols: [_this.tableColumn],
                    cellMinWidth: 120,
                    height: 431,
                    limit: _this.pagination.size,
                });
                //点击主表格内单元格时触发的方法
                _this.rowInLineOperationFunc();
            });
        },
        //导出生产风险使用
        //导出生产风险页面使用
        exportItemInfoSC: function (fileName) {
            var _this = this;
            var exportObj = {};
            //获取表格中被勾选的数据的集合
            var checkStatus = _this.table.checkStatus('main_table')
            var data = checkStatus.data;
            //获取每条数据的id，并添加进新的数组中
            var ids = []
            data.forEach(function (item) {
                ids.push(item.id)
            });
            exportObj = JSON.parse(JSON.stringify(_this.searchParam));
            exportObj.ids = ids;
            fetch(_this.exportDataUrl, {
                method: 'post',
                headers: {
                    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
                    'Content-Type': 'application/json',
                    "type":"CASTGC",
                            "CASTGC": layui.config.CASTGC,
                },
                'credentials': 'include',
                body: JSON.stringify(exportObj),
            })
                .then(res => res.blob())
                .then(blob => {
                    var a = document.createElement('a');
                    var url = window.URL.createObjectURL(blob);
                    a.href = url;
                    a.setAttribute("download", fileName + _this.currentDate + '.xlsx');
                    a.click();
                    window.URL.revokeObjectURL(url);
                })
        },
        /**
         * author: zhangqi
         * description: 加载表格分页
         * time: 2020/09/17
         */
        loadTablePager: function () {
            var _this = this;
            layuiEvent.laypage.render({
                elem: 'tablePager',
                count: _this.pagination.total,
                layout: ['count', 'limit', 'prev', 'page', 'next', 'skip'],
                prev: '<em><i class="layui-icon" style="font-size: 20px"><</i></em>',
                next: '<em><i class="layui-icon" style="font-size: 20px">></i></em>',
                jump: function (obj) {
                    _this.pagination.size = obj.limit;
                    _this.pagination.current = obj.curr;
                    _this.getTableDataFunc();
                }
            });
        },

        /*
        * author: zhangqi
        * description: 点击主表格内单元格时触发的方法
        * time: 2020/09/17
        */
        rowInLineOperationFunc: function () {
            var _this = this;
            //表格行内的操作，包括获取表格单行的数据，表格单行中‘编辑’或‘删除’的方法
            _this.table.on('tool(main_test)', function (obj) {
                var data = obj.data;
                if (obj.event === 'setSign') {
                    searchViceObjParam.parentId = data.id;
                    //将全局变量传入中间组件transferParam中，用于查询副表格数据
                    transfer.$emit('transferParam', searchViceObjParam);
                }
                _this.$emit('tableoperation', obj);
            });
        },


        /**
         * description:点击表格上方‘新增’按钮执行的方法
         * author:zhangqi
         * time: 2020-09-16
         */
        addDataFunc: function (size, dateType, domId) {
            var _this = this;
            //清空下拉菜单带有分页表格的方法中的补充查询条件的变量，防止存在数据联动的情况下，导致被联动的部分数据查询不正确
            _this.linkageParamObj = {};
            _this.loadDataTimePickerFunc(dateType, domId);
            size = size || _this.size;
            //给表单中提交方法的类型的变量赋值, 判断是新增方法,还是编辑方法, 1-新增 2-编辑
            _this.submitFormType = 1;
            //清空表单中所有内容，
            document.getElementById("layui-form").reset();
            _this.layerBox = layer.open({
                type: 1,
                title: '新增',
                closeBtn: 1,
                area: [size.width + 'px', size.height + 'px'],
                shade: false,
                shadeClose: false,
                content: $("#layui-form")
            });
        },
        //订单管理生产能力用add

        /*
        * author: zhangqi
        * description: 主表格顶部编辑按钮执行的方法
