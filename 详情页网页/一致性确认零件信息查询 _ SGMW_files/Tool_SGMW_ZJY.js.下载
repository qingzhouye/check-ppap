    created: function () {
        var _this = this;
        transfer.$off('transferParam');
        transfer.$on("transferParam", function (msg) {
            _this.searchViceObj = {};
            _this.searchViceObj = msg;
            _this.drawViceTableFunc();
        });
    },
    beforeDestroy() {
        transfer.$off('transferParam');
    },
    mounted: function () {
        var _this = this;
        //在前端定义好副表格的表单中是否有下拉菜单，如果有这个变量，则执行下方方法，循环对象数组，获取每个下拉菜单对应的数据
        if (_this.viceFormSelectInterfaceArr != undefined) {
            _this.getViceFormSelectDataFunc();
        }
        //在前端定义好副表格的表单中是否有下拉菜单联动回显功能，如果有这个变量，则执行下方方法
        if (_this.viceFormEchoInterfaceArr != undefined) {
