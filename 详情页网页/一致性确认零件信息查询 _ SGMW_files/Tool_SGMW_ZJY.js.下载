var firstOrdinaryShowTableDataAssembly = Vue.component('first-ordinary-show-table-data-assembly-zjy', {
    props: ['headData', 'fieldData', 'fixedColumn', 'isCheckBox', 'isNumber', 'align', 'firstTempletList', 'getTableDataUrl'],
    data: function () {
        return {
            table: {},
            columnObj: {},
            columnObjArr: [],
            tableColumn: [],
            mainTableCheckedDataId: "",
            searchParam: {}
        }
    },
    template:
        '<div>' +
        '<table id="first_ordinary_table" lay-filter="first_ordinary_table_test"></table>' +
        '</div>',

    methods: {
        /*
        * author: zhangqi
        * description: 拼接绘制渲染表格
        * time: 2020/09/16
        */
        drawTableFunc: function (paramObj) {
            var _this = this;
            paramObj = paramObj || {}
            _this.tableColumn = [];
            _this.columnObjArr = [];
            //判断表格是否开启多选列，如果开启在表格中添加多选列
            if (_this.isCheckBox) {
                _this.tableColumn.push({type: 'checkbox', fixed: 'left', event: 'setSign'})
            }
            //判断表格是否开启序号列，如果开启在表格中添加序号列
            if (_this.isNumber) {
                _this.tableColumn.push({type: 'numbers', title: '序号', fixed: 'left'})
            }

            // 循环表头数据，整合绘制表格所需要的数据格式event: 'setSign'
            _this.headData.forEach(function (item) {
                _this.columnObj = {title: item, align: _this.align}
                if (_this.firstTempletList != undefined) {
                    _this.columnObj.templet = _this.firstTempletList[item];
                }
                _this.columnObjArr.push(_this.columnObj);
                _this.columnObj = {};
            });
            // 循环数据字段的数组，赋值给中间变量数组中的字段，整合绘制表格所需要的数据格式
            _this.fieldData.forEach(function (item, index) {
                _this.columnObjArr[index].field = item;
            });

            // 循环是否固定列的数组，赋值给中间变量数组中的字段，整合绘制表格所需要的数据格式
            if (_this.fixedColumn != undefined) {
                _this.fixedColumn.forEach(function (item, index) {
                    _this.columnObjArr[index].fixed = item;
                });
            }

            // 循环中间变量数组，将数组中的每一条数据添加进新的数组中，然后新的数组是表格所需要的并且已经整理好格式的数据
            _this.columnObjArr.forEach(function (item) {
                _this.tableColumn.push(item)
            });

            layui.use('table', function () {
                _this.table = layui.table
                //展示已知数据
                _this.table.render({
                    elem: '#first_ordinary_table',
                    url: _this.getTableDataUrl,
                    cols: [_this.tableColumn],
                    where: paramObj,
                    limit: Number.MAX_VALUE,
                    parseData: function (res) { //res 即为原始返回的数据
                        return {
                            "code": res.respCode, //解析接口状态
                            "msg": res.message, //解析提示文本
                            "count": res.data.total, //解析数据长度
                            "data": res.data.details //解析数据列表
                        };
                    },
                });
            });
        },
    }
});

