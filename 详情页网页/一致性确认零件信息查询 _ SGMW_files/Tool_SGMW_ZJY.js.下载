// 可以上传多个文件，并且可以显示上传文件名称，还可进行删除或下载功能的组件
var uploadFileAssembly = Vue.component('upload-file-assembly-zjy', {

    props: ["uploadFileUrl", "maxFileSize", "getUploadFileObjArrUrl", "downloadFileUrl"],
    data: function () {
        return {
            // 新建 查看 修改文件 回显数据
            uploadData: [],
            lookbannerData: {},//当前查看的公告信息
            readOnly: true,//是否可以编辑
        }
    },
    template:
        '<div>' +
        '<div id="ptr-parts-round" style="padding: 20px; padding-top: 0; display: flex; align-items: flex-start;flex-direction: column;">' +
        '<div class="layui-upload"  v-show="!readOnly">' +
        '<button type="button" class="layui-btn layui-btn-normal" id="test3"><i class="layui-icon"></i>上传文件</button>' +
        '<span style="color: red;padding-left: 10px">请上传50M以内并且带有公章的文件</span>' +
        '</div>' +
        '<label v-show="readOnly" style="font-size: 14px">附件:</label>' +
        '<p style="margin-top: 5px; font-size: 14px;" v-for="(item,index) in uploadData" :key="index">{{item.fileName}}<a href="javascript:;" style="padding-left: 10px;" @click="load(item)" v-if="readOnly">下载</a><a href="JavaScript:;" style="padding-left: 10px;" @click="removefiled(index)" v-else>删除</a></p>' +
        '</div>' +
        '</div>',

    mounted() {
        var _this = this;
        if (_this.uploadFileUrl != undefined) {
            _this.upload();
        }
    },
    methods: {
        /*
        * author: zhangqi
        * description: 根据查询条件，调用接口，查询并获取表格数据
        * time: 2020/09/21
        */

        upload: function () {
            var _this = this;
            layuiEvent.upload.render({
                elem: '#test3',
                url: _this.uploadFileUrl, //改成您自己的上传接口
                // auto: false,
                accept: 'file', //普通文件
                // acceptMime: '.docx,.xlsx,.xls,.csv,.pdf,.ppt,.rar,.txt,', //选择文件时，过滤掉这三种文件之外的所有文件
                //exts: 'docx|xlsx|xls|csv|pdf|ppt|rar|txt|', //普通文件
                size: _this.maxFileSize * 1024,
                choose: function (obj) {
                    var files = this.files = obj.pushFile();
                },
                done: function (res, index) {
                    delete this.files[index];
                    var flage = true;
                    _this.uploadData.forEach(function (item) {
                        if (item.fileName == res.data.fileName) {
                            flage = false;
                        }
                    })
                    if (flage) {
                        _this.uploadData.push({fileName: res.data.fileName, fileId: res.data.fileId});
                        layer.msg('上传成功');
                    } else {
                        layer.msg('文件名重复');
                    }
                }
            });
        },

        /*
         * author: zhangqi
         * description: 根据主表格中数据的id 获取数据中上传的文件对象数组
         * param: mainTableId 一个对象，{key:value}格式，主表格中被选中的数据的id
         * time: 2020/10/26
         */
        getUploadFileObjArrByMainTableID: function (mainTableId) {
            var _this = this;
            layuiEvent.admin.req(_this.getUploadFileObjArrUrl, mainTableId, function (res) {
                    if (res.ok) {
                        _this.uploadData = res.data
                    } else {
                        layerInfo(res.message, 2);
                    }
                }, {method: 'GET'}
            )
        },

        /**
         * description: 查看下载附件
         * author:zhangqi
         * time: 2020-10-26
         */
        load: function (item) {
            var _this = this;
            var link = document.createElement('a');
            link.setAttribute("download", item.fileName);
            link.href = layui.config.setToken(_this.downloadFileUrl + '?fileId=' + item.fileId)
            link.click();
        },

        /**
         * description: 删除也上传文件方法
         * author:linzijain
         * time: 2020-09-24
         */
        removefiled: function (index) {
            var _this = this;
            _this.uploadData.splice(index, 1)
            if (!!_this.lookbannerData.fileIds) {
                _this.lookbannerData.fileIds.splice(index, 1);
            }
        },

        /**
         * description: 在保存新增的数据时，要同时把上传的文件一起保存，在这个方法中整合数据格式，传入接口
         * author:linzijain
         * time: 2020-09-24
         */
        getUploadData() {
            var _this = this;
            var fileObjArr = [];
            _this.uploadData.forEach(function (item) {
                fileObjArr.push({fileName: item.fileName, fileId: item.fileId});
            })
            return fileObjArr;
        },

    }
});

