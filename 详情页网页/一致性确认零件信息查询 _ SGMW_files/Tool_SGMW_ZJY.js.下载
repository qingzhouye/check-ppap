        /*
        * author: zhangqi
        * description: 获取页面顶部查询条件中，下拉菜单类型的查询条件中的所有数据，这个方法在此js中封装，
        *              可以简化前端页面的代码重复性，当选择好下拉菜单中的数据后，点击查询可以直接根据查询条件获取表格数据
        * time: 2020/09/22
        */
        getSearchDataFunc: function () {
            var _this = this;
            _this.selectInterfaceArr.forEach(function (ss) {
                $.each(ss, function (key, val) {
                    if (val) {

                        layuiEvent.admin.req(val, {}, function (res) {
                                if (res.ok) {
                                    res.data.forEach(function (item) {
                                        $('#' + key).append("<option value='" + item + "'>" + item + "</option>");
                                        layuiEvent.form.render("select");
                                    })
                                    layuiEvent.form.on('select(' + key + ')', function (data) {//对应lay-filter
                                        if (key == 'changeType') {
                                            switch (data.value) {
                                                case '代码变更':
                                                    return _this.searchParam[key] = 1
                                                case '名称变更':
                                                    return _this.searchParam[key] = 2
                                                case '退出':
                                                    return _this.searchParam[key] = 3
                                                case '计划员':
                                                    return _this.searchParam[key] = 1
                                                case '采购员':
                                                    return _this.searchParam[key] = 2
                                                case 'SQ':
                                                    return _this.searchParam[key] = 3
                                                case '':
                                                    return _this.searchParam[key] = ''
                                            }
                                            ;
                                        } else {
                                            _this.searchParam[key] = data.value;
                                        }
                                    })
                                } else {
                                    layerInfo(res.message, 2);
                                }
                            }, {method: 'GET'}
                        );
                    } else {
                        //如果下拉菜单属于选择‘是或否’，或是选择‘时间’的类型，这种类型的是直接在前端定义好选项的，但是没有定义接口路径
                        //这样的情况在，在当前的这个方法中就是没有参数val，所以执行else中的方法，直接监听在前端定义好内容的下拉菜单的选的内容，
                        //赋值给前端定义的_this.searchParam对象中对应的变量
                        layuiEvent.form.on('select(' + key + ')', function (data) {//对应lay-filter
                            _this.searchParam[key] = data.value;
                        })
                    }
                })
            })
        },

        /*
        * author: zhangqi
        * description: 获取新增或编辑的表单中，下拉菜单类型的查询条件中的所有数据，这个方法在此js中封装，
        *              可以简化前端页面的代码重复性，当选择好下拉菜单中的数据后，这样操作还可以直接获取选择的数据，传入接口中（单一下拉）
        * time: 2020/09/22
        */
        getFormSelectDataFunc: function () {
            var _this = this;
            _this.mainFormSelectInterfaceArr.forEach(function (ss) {
                if (ss.name) {
                    layuiEvent.admin.req(ss.url, {}, function (res) {
                            if (res.ok) {
                                for (let key in res.data) {
                                    if (key == ss.name) {
                                        ss.data = res.data[key]
                                    }
                                }
                                ss.data.forEach(function (item) {
                                    $('#' + ss.name).append("<option value='" + item + "'>" + item + "</option>");
                                    layuiEvent.form.render("select");
                                });
                            } else {
                                layerInfo(res.message, 2);
                            }
                        }, {method: 'GET'}
                    );
                    if (ss.linkageUrl) {
                        layuiEvent.form.on('select(form_' + ss.name + ')', function (data) {
                            if (data.value) {
                                layuiEvent.admin.req(ss.linkageUrl, {stage: data.value}, function (res) {
                                    if (res.ok) {
                                        res.data.forEach(function (item) {
                                            $('#' + ss.childSelectName).append("<option value='" + item + "'>" + item + "</option>");
                                            layuiEvent.form.render("select");
                                        })
                                    } else {
                                        layerInfo(res.message, 2);
                                    }
                                }, {method: 'GET'});
                            } else {
                                $('#' + ss.childSelectName).html("");
                                $('#' + ss.childSelectName).append("<option value=''>请选择</option>");
                                layuiEvent.form.render("select");
                            }
                            layuiEvent.form.render("select");
                        })
                    }
                } else {
                    $.each(ss, function (key, val) {
                        layuiEvent.admin.req(val, {}, function (res) {
                                if (res.ok) {
                                    res.data.forEach(function (item, i) {
                                        $('#' + key).append("<option value='" + (i + 1) + "'>" + item + "</option>");
                                        layuiEvent.form.render("select");
                                    })
                                } else {
                                    layerInfo(res.message, 2);
                                }
                            }, {method: 'GET'}
                        );
                    })
                }
            })
        },

        /*
         * author: zhangqi
         * description: 下拉菜单与文本框联动回显的方法
         * time: 2020/10/22
         */
        getEchoSelectDataFunc: function () {
            var _this = this;
            var str = '';
            _this.mainFormEchoInterfaceArr.forEach(function (ss) {
                $.each(ss, function (key, val) {
                    layuiEvent.form.on('select(' + key + ')', function (data) {
                        $.each(val, function (key1, val1) {
                            $.each(val1, function (key2, val2) {
                                if (data.value) {
                                    layuiEvent.admin.req(val2, {[key1]: data.value}, function (res) {
                                        if (res.ok) {
                                            _this.formObjParam[key2] = res.data[key2];
                                            // layuiEvent.form.render("select");
                                        } else {
                                            layerInfo(res.message, 2);
                                        }
                                    }, {method: 'GET'});
                                } else {
                                    _this.formObjParam[key2] = '';
                                    // layuiEvent.form.render("select");
                                }
                            });
                        });
                    })
                })
            })
        },

