function searchDatafotmat_one(SearchData) {
    var searchdata = {}
    if (!SearchData) {
        searchdata = {dateType: "day"};
    } else {
        if (!SearchData || !SearchData.searchStartDate || SearchData.searchStartDate.length < 7) {
            SearchData.searchStartDate = '';
            SearchData.searchEndDate = '';
        } else if (SearchData.searchStartDate[0] == '-') {
            SearchData.searchStartDate = '';
            SearchData.searchEndDate = '';
        }
        // if (SearchData.searchEndDate.split('-')[1] == '02' && SearchData.dateType.dateType !== 'month') {
        //     SearchData.searchEndDate = SearchData.searchStartDate.substr(0, SearchData.searchStartDate.length - 2) + '28';
        // }
        var year = SearchData.searchEndDate.substring(0, 4); //获取当前4位数的年份
        var mounth = SearchData.searchEndDate.substring(5)

        var sameMonthLastDay = new Date(year, mounth, 0).getDate() //获取当前年的当前月的最后一天的日期
        searchdata = {
            startDate: SearchData.searchStartDate.length !== 3 && SearchData.searchStartDate.length < 10 && SearchData.searchStartDate !== '' ? SearchData.searchStartDate + '-01' : SearchData.searchStartDate,//开始时间
            endDate: SearchData.searchEndDate.length !== 3 && SearchData.searchEndDate.length < 10 && SearchData.searchEndDate !== '' ? SearchData.searchEndDate + '-' + sameMonthLastDay : SearchData.searchEndDate,//结束时间
            dateType: SearchData.dateType.dateType ? SearchData.dateType.dateType : SearchData.dateType,//时间类型
            supplierCode: SearchData.supplierCode,//供应商代码
            businessDepartment: SearchData.businessDepartment,//业务科室
            carTypeCode: SearchData.model,//车型
            baseCode: SearchData.productionBase,//基地
            partCode: SearchData.partNumber,//零件号
            gapStart: SearchData.gapStart,//起始缺口数值
            gapEnd: SearchData.gapEnd,//结束缺口数值
        }
        if (SearchData.searchStartDate == '') {
            searchdata.startDate = '';
            searchdata.endDate = '';
        }
        if (SearchData.ctFunctionModuleChild) {
            searchdata['childrenFunctionCode'] = SearchData.ctFunctionModuleChild;//tp父
        } else {
            searchdata['parentFunctionCode'] = SearchData.ctFunctionModule;//tp子
        }
    }
    return searchdata
}

